rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && (
        (request.auth.token.roles != null && role in request.auth.token.roles) ||
        (request.auth.token.primaryRole == role)
      );
    }

    function isSelf(userId) {
      return isSignedIn() && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    // ครูที่ปรึกษา (HOMEROOM_TEACHER) ของห้องที่ระบุ — เทียบ staff/{uid}.assignments.homeroomClass
    // (staff อ่านได้โดย signed-in ทุกคนอยู่แล้ว จึง get() ได้; ใช้ .get(k, default) กัน field ไม่มี)
    function isHomeroomTeacherOf(roomValue) {
      return hasRole('HOMEROOM_TEACHER')
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('assignments', {}).get('homeroomClass', '') == roomValue;
    }

    // ค่าจาก students/{studentId} จริง — ใช้ตอน create เพื่อกันนักเรียน denormalize ผิด
    function studentField(sid, key, fallback) {
      return get(/databases/$(database)/documents/students/$(sid)).data.get(key, fallback);
    }

    // นักเรียนเจ้าของ sid (5 หลัก) จริง — เทียบผ่าน students/{sid}.studentUid ไม่ใช่เทียบ
    // request.auth.uid กับ sid ตรงๆ (sid เป็นรหัสนักเรียน 5 หลัก ไม่ใช่ Firebase Auth UID เด็ดขาด
    // เทียบตรงจะไม่มีวันจริงสำหรับนักเรียนจริงสักคน — ดู student_screenings_2q/phq9 ด้านล่าง)
    function isSelfStudent(sid) {
      return isSignedIn() && studentField(sid, 'studentUid', '__none__') == request.auth.uid;
    }

    // ครูผู้สอนของ schedule (section) นี้ — เทียบ schedules/{scheduleId}.teacherId/teacherIds
    // ใช้ให้ครูถอนชื่อนักเรียนออกจากชุมนุม/กิจกรรม ELECTIVE ของตัวเองเท่านั้น (activity_enrollments)
    function isTeacherOfSchedule(scheduleId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/schedules/$(scheduleId))
        && (
          get(/databases/$(database)/documents/schedules/$(scheduleId)).data.get('teacherId', '') == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/schedules/$(scheduleId)).data.get('teacherIds', [])
        );
    }

    // 1. Students Collection
    // อ่านทะเบียนนักเรียนได้: บุคลากรที่ต้องใช้รายชื่อทั้งโรงเรียน (ครู/ผู้บริหาร/แนะแนว/พยาบาล/การเงิน/ศึกษานิเทศก์)
    // + ผู้ปกครองอ่านได้เฉพาะบุตรหลานตัวเอง (ต้อง query where('parentUid','==', uid) เพื่อให้ list ผ่าน)
    // + นักเรียนอ่านได้เฉพาะ record ของตัวเอง (ต้อง query where('studentUid','==', uid) เพื่อให้ list ผ่าน)
    match /students/{studentId} {
      allow read: if hasRole('SUPER_ADMIN') ||
                     hasRole('EXECUTIVE') ||
                     hasRole('SUBJECT_TEACHER') ||
                     hasRole('HOMEROOM_TEACHER') ||
                     hasRole('GUIDANCE_COUNSELOR') ||
                     hasRole('INFIRMARY_STAFF') ||
                     hasRole('FINANCE_STAFF') ||
                     hasRole('INSTRUCTIONAL_SUPERVISOR') ||
                     (isSignedIn() && resource.data.parentUid == request.auth.uid) ||
                     (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow write: if hasRole('SUPER_ADMIN') || hasRole('HOMEROOM_TEACHER');
    }

    // 2. Mental Health & Counseling Self-Assessments (PHQ-9, SDQ)
    match /student_self_assessments/{studentId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('GUIDANCE_COUNSELOR') || 
                     isSelf(resource.data.studentId) || 
                     isSelf(resource.data.studentUid);
      allow write: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isSelf(studentId);
    }

    // 3. Discipline & Behavior Logs
    match /discipline_logs/{logId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     hasRole('EXECUTIVE') || 
                     hasRole('GUIDANCE_COUNSELOR');
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('SUBJECT_TEACHER') || 
                      hasRole('HOMEROOM_TEACHER');
    }

    // 4. Parent Notifications
    match /parent_notifications/{notifId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.parentId == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('HOMEROOM_TEACHER') || 
                      hasRole('SUBJECT_TEACHER');
    }

    // 5. Parent-Teacher Conferences
    match /parent_conferences/{confId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.parentId == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || hasRole('HOMEROOM_TEACHER');
    }

    // 6. Timetables & Schedules
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN') || hasRole('HOMEROOM_TEACHER') || hasRole('SUBJECT_TEACHER');
    }

    // 7. Attendance Records
    match /attendance_records/{recordId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('EXECUTIVE') || 
                     hasRole('SUBJECT_TEACHER') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.studentUid == request.auth.uid || resource.data.studentId == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('SUBJECT_TEACHER') || 
                      hasRole('HOMEROOM_TEACHER');
    }

    // 8. Gradebook Scores
    match /gradebook_scores/{scoreId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('EXECUTIVE') || 
                     hasRole('SUBJECT_TEACHER') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     hasRole('HEAD_OF_DEPARTMENT') || 
                     (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.studentUid == request.auth.uid || resource.data.studentId == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('SUBJECT_TEACHER') || 
                      hasRole('HEAD_OF_DEPARTMENT');
    }

    // 9. Admin Periods Configuration
    match /admin_periods_config/{periodId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN');
    }

    // 10. School Settings (periods_config, etc.)
    match /school_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN');
    }

    // 11. Staff Directory
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN');
    }

    // 12. Teachers Directory
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN');
    }

    // 13. Seating Layouts & Subcollections (groups, seats)
    match /seating_layouts/{layoutId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN') || hasRole('SUBJECT_TEACHER') || hasRole('HOMEROOM_TEACHER');

      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if hasRole('SUPER_ADMIN') || hasRole('SUBJECT_TEACHER') || hasRole('HOMEROOM_TEACHER');
      }
    }

    // 14. Seating Assignments (History and Active)
    match /seating_assignments/{assignmentId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('EXECUTIVE') || 
                     hasRole('SUBJECT_TEACHER') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     (isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.parentUid == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('SUBJECT_TEACHER') || 
                      hasRole('HOMEROOM_TEACHER');
    }

    // 15. Gate Attendance Logs
    match /gate_attendance_logs/{logId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('EXECUTIVE') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     hasRole('SUBJECT_TEACHER') || 
                     (isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.parentUid == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('HOMEROOM_TEACHER') || 
                      hasRole('SUBJECT_TEACHER') || 
                      (isSignedIn() && (request.resource.data.studentId == request.auth.uid || request.resource.data.userId == request.auth.uid));
    }

    // 16. Detailed Leave Requests
    match /detailed_leave_requests/{leaveId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     hasRole('EXECUTIVE') || 
                     (isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.parentUid == request.auth.uid || resource.data.parentId == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('HOMEROOM_TEACHER') || 
                      (isSignedIn() && (request.resource.data.studentId == request.auth.uid || request.resource.data.parentUid == request.auth.uid || request.resource.data.parentId == request.auth.uid));
    }

    // 17. GPS Check-in Logs
    match /gps_check_in_logs/{logId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('EXECUTIVE') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     hasRole('SUBJECT_TEACHER') || 
                     (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.studentId == request.auth.uid || resource.data.parentUid == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('HOMEROOM_TEACHER') || 
                      hasRole('SUBJECT_TEACHER') || 
                      (isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.studentId == request.auth.uid));
    }

    // 18. Substitute Teaching Assignments & Post Teaching Records
    // TODO(security): ตอนนี้ write เป็น role-based ล้วน (ยังบังคับลำดับ 4 ขั้นที่ layer นี้ไม่ได้).
    //   หลัง workflow ฝั่ง client verify ผ่าน emulator แล้ว ให้เพิ่มการตรวจ:
    //   - อนุมัติได้เฉพาะเมื่อ request.resource.data.currentApprovalStage ตรงกับ role ผู้เขียน
    //     (STAGE_1→HEAD_OF_DEPARTMENT, STAGE_2→ACADEMIC_HEAD, STAGE_3→DEPUTY_DIRECTOR_ACADEMIC, STAGE_4→DIRECTOR)
    //   - currentApprovalStage เดินหน้าได้ทีละขั้น (ห้ามข้าม), ห้าม downgrade
    //   - SUBJECT_TEACHER แก้ได้เฉพาะ field ชุด completion* / isCompleted / completedAt เท่านั้น
    match /substitute_assignments/{assignmentId} {
      allow read: if isSignedIn();
      // SUBJECT_TEACHER/HOMEROOM_TEACHER เขียนได้เพื่อรองรับครูขอลากิจ/ไปราชการด้วยตนเอง
      // (สถานะเริ่มต้นล็อกที่ STAGE_1_HEAD_OF_DEPARTMENT เสมอในโค้ด client — ดู proposeSubstituteAssignment)
      allow write: if hasRole('SUPER_ADMIN') ||
                      hasRole('HEAD_OF_DEPARTMENT') ||
                      hasRole('ACADEMIC_HEAD') ||
                      hasRole('DEPUTY_DIRECTOR_ACADEMIC') ||
                      hasRole('DIRECTOR') ||
                      hasRole('EXECUTIVE') ||
                      hasRole('SUBJECT_TEACHER') ||
                      hasRole('HOMEROOM_TEACHER');
    }

    match /post_teaching_records/{recordId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('HEAD_OF_DEPARTMENT') || 
                      hasRole('ACADEMIC_HEAD') || 
                      hasRole('DEPUTY_DIRECTOR_ACADEMIC') || 
                      hasRole('DIRECTOR') || 
                      hasRole('EXECUTIVE') || 
                      hasRole('SUBJECT_TEACHER');
    }

    // 19. Student Health & Mental Screenings (2Q, PHQ-9, SDQ)
    // FIX: doc id {studentId} คือรหัสนักเรียน 5 หลัก (ดู save2QScreeningFirestore/savePHQ9ScreeningFirestore
    // ใน firestoreService.ts) ไม่ใช่ Firebase Auth UID — isSelf(studentId) เดิมเทียบ auth.uid กับรหัส 5 หลัก
    // ตรงๆ จึงไม่มีวันจริงเลย ทำให้นักเรียนทำแบบคัดกรองของตัวเองไม่ผ่าน rules เงียบๆ (เห็นเหมือนบันทึกสำเร็จ
    // ฝั่ง UI เพราะ optimistic local state แต่ Firestore ปฏิเสธจริง) แก้เป็น isSelfStudent() ที่เทียบผ่าน
    // students/{studentId}.studentUid จริงแทน — ไม่ได้เปลี่ยนว่าใครมีสิทธิ์ (ยังเป็นเจ้าของตัวเอง/
    // ครูประจำชั้น/ครูแนะแนว/แอดมินเหมือนเดิม) แค่แก้วิธีตรวจว่า "ตัวเอง" ให้ตรงกับที่ระบบตั้งใจไว้จริง
    match /student_screenings_2q/{studentId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || hasRole('HOMEROOM_TEACHER') || isSelfStudent(studentId);
      allow write: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || hasRole('HOMEROOM_TEACHER') || isSelfStudent(studentId);
    }

    match /student_screenings_phq9/{studentId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || hasRole('HOMEROOM_TEACHER') || isSelfStudent(studentId);
      allow write: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || hasRole('HOMEROOM_TEACHER') || isSelfStudent(studentId);
    }

    match /student_assessments_sdq/{sdqId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('GUIDANCE_COUNSELOR') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     (isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.studentUid == request.auth.uid || resource.data.evaluatorId == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('GUIDANCE_COUNSELOR') || 
                      hasRole('HOMEROOM_TEACHER') || 
                      (isSignedIn() && (request.resource.data.studentId == request.auth.uid || request.resource.data.studentUid == request.auth.uid || request.resource.data.evaluatorId == request.auth.uid));
    }

    // 20. Billing Invoices, Messages, and Appointments
    match /billing_invoices/{invoiceId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('EXECUTIVE') || 
                     (isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.parentUid == request.auth.uid || resource.data.parentId == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.parentId == request.auth.uid || resource.data.studentId == request.auth.uid));
    }

    match /parent_teacher_messages/{msgId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     hasRole('SUBJECT_TEACHER') || 
                     (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.parentId == request.auth.uid || resource.data.studentId == request.auth.uid || resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('HOMEROOM_TEACHER') || 
                      hasRole('SUBJECT_TEACHER') || 
                      (isSignedIn() && (request.resource.data.parentUid == request.auth.uid || request.resource.data.parentId == request.auth.uid || request.resource.data.senderId == request.auth.uid || request.resource.data.studentId == request.auth.uid));
    }

    match /parent_appointments/{appointmentId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     hasRole('SUBJECT_TEACHER') || 
                     (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.parentId == request.auth.uid || resource.data.studentId == request.auth.uid || resource.data.teacherId == request.auth.uid || resource.data.teacherEmail == request.auth.token.email));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('HOMEROOM_TEACHER') || 
                      hasRole('SUBJECT_TEACHER') || 
                      (isSignedIn() && (request.resource.data.parentUid == request.auth.uid || request.resource.data.parentId == request.auth.uid || request.resource.data.studentId == request.auth.uid));
    }

    // 21. Active Learning Records
    match /active_learning_logs/{logId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN') || hasRole('SUBJECT_TEACHER') || hasRole('HOMEROOM_TEACHER');
    }

    // 23. Late Attendance Requests — ครูผู้สอนขอ "เช็คชื่อย้อนหลัง" เมื่อลืมเช็คในคาบ
    // ผู้อนุมัติ: DEPUTY_DIRECTOR_ACADEMIC (รองผู้อำนวยการฝ่ายวิชาการ) / SUPER_ADMIN — ยืนยันจากทางโรงเรียน
    // document ไม่ถูกลบตอนอนุมัติ/ปฏิเสธ (allow delete: if false) — เก็บประวัติ เปลี่ยนแค่ status
    match /late_attendance_requests/{reqId} {
      // DIRECTOR อ่านได้เพื่อกำกับดูแล (read-only) — การอนุมัติจริงจบที่ DEPUTY_DIRECTOR_ACADEMIC
      allow read: if hasRole('SUPER_ADMIN') ||
                     hasRole('DEPUTY_DIRECTOR_ACADEMIC') ||
                     hasRole('DIRECTOR') ||
                     hasRole('EXECUTIVE') ||
                     (isSignedIn() && resource.data.teacherId == request.auth.uid);

      // ครูสร้างคำขอของตัวเองได้เท่านั้น และต้องเริ่มที่สถานะ PENDING
      allow create: if (hasRole('SUBJECT_TEACHER') || hasRole('HOMEROOM_TEACHER')) &&
                       request.resource.data.teacherId == request.auth.uid &&
                       request.resource.data.status == 'PENDING';

      // อนุมัติ/ปฏิเสธ (แก้ status): เฉพาะรองผอ.วิชาการ / SUPER_ADMIN
      // ห้ามแก้ teacherId / scheduleId (ตรึงไว้ให้ตรงกับของเดิม)
      allow update: if (hasRole('DEPUTY_DIRECTOR_ACADEMIC') || hasRole('SUPER_ADMIN')) &&
                       request.resource.data.teacherId == resource.data.teacherId &&
                       request.resource.data.scheduleId == resource.data.scheduleId;

      allow delete: if false;
    }

    // 22. Parent Verification Records (identity matching for LINE/LIFF account linking)
    // ข้อมูลอ่อนไหวตาม PDPA (hash เลขบัตร ปชช. + เบอร์โทร) — ใช้เทียบยืนยันฝั่ง backend เท่านั้น
    // SUPER_ADMIN เท่านั้นที่อ่าน/เขียนได้ (แม้แต่ผู้ปกครองเจ้าของข้อมูลก็ไม่ควรอ่านได้จาก client)
    match /parent_verification_records/{recordId} {
      allow read, write: if hasRole('SUPER_ADMIN');
    }

    // 24. Student Portfolio Entries — นักเรียนบันทึกผลงานเอง (รางวัล/อบรม/ฝึกงาน/จิตอาสา)
    //     ต้องผ่านการอนุมัติจากครูที่ปรึกษาก่อนแสดงให้ผู้ปกครอง/แดชบอร์ดวิชาการ
    match /student_portfolio_entries/{entryId} {
      // นักเรียนเห็นของตัวเองทุกสถานะ; ครูที่ปรึกษาห้องนั้นเห็นทั้งหมด;
      // ผู้ปกครองเห็นเฉพาะ APPROVED ของบุตรหลาน (query where('parentUid','==',uid) + where('status','==','APPROVED'))
      allow read: if hasRole('SUPER_ADMIN')
                     || (isSignedIn() && resource.data.studentUid == request.auth.uid)
                     || isHomeroomTeacherOf(resource.data.homeroomClass)
                     || (resource.data.status == 'APPROVED' && isSignedIn() && resource.data.parentUid == request.auth.uid);

      // นักเรียนสร้างได้เฉพาะของตัวเอง + status เริ่มต้น PENDING เท่านั้น + ยังไม่มีผลรีวิว
      // homeroomClass / parentUid ต้องตรงกับ students/{studentId} จริง (กัน denormalize มั่ว)
      allow create: if isSignedIn()
                       && request.resource.data.studentUid == request.auth.uid
                       && request.resource.data.status == 'PENDING'
                       && request.resource.data.reviewedBy == null
                       && request.resource.data.reviewedAt == null
                       && request.resource.data.rejectReason == null
                       && request.resource.data.homeroomClass == studentField(request.resource.data.studentId, 'room', '__none__')
                       && request.resource.data.studentUid == studentField(request.resource.data.studentId, 'studentUid', '__none__');

      // ครูที่ปรึกษา/SUPER_ADMIN แก้ได้เฉพาะฟิลด์รีวิว — ห้ามแก้เนื้อหาที่นักเรียนกรอก
      allow update: if (hasRole('SUPER_ADMIN') || isHomeroomTeacherOf(resource.data.homeroomClass))
                       && request.resource.data.studentUid == resource.data.studentUid
                       && request.resource.data.studentId == resource.data.studentId
                       && request.resource.data.homeroomClass == resource.data.homeroomClass
                       && request.resource.data.parentUid == resource.data.parentUid
                       && request.resource.data.type == resource.data.type
                       && request.resource.data.title == resource.data.title
                       && request.resource.data.description == resource.data.description
                       && request.resource.data.entryDate == resource.data.entryDate
                       && request.resource.data.status in ['APPROVED', 'REJECTED'];

      allow delete: if false;
    }

    // 25. Student Home Locations — พิกัด GPS + ภาพบ้านนักเรียน (วางแผนออกเยี่ยมบ้าน)
    //     อ่อนไหวเรื่องความปลอดภัยที่อยู่อาศัย: เจ้าของ + ครูที่ปรึกษาห้องนั้น + SUPER_ADMIN เท่านั้น
    //     **ผู้ปกครองและครูวิชาอื่นเข้าถึงไม่ได้**
    match /student_home_locations/{studentId} {
      // resource == null = doc ยังไม่ถูกสร้าง (นักเรียนเปิดหน้าก่อนบันทึกครั้งแรก) —
      // ต้องยอมให้ get ผ่านแบบ "ไม่มีข้อมูล" ไม่งั้น rule error (Null value) แล้ว listener พัง
      allow read: if hasRole('SUPER_ADMIN')
                     || (isSignedIn() && resource == null)
                     || (resource != null && resource.data.studentUid == request.auth.uid)
                     || (resource != null && isHomeroomTeacherOf(resource.data.homeroomClass));

      // นักเรียนเขียนของตัวเองเท่านั้น; homeroomClass ต้องตรงกับ students/{studentId} จริง
      allow create, update: if isSignedIn()
                       && request.resource.data.studentUid == request.auth.uid
                       && request.resource.data.studentId == studentId
                       && request.resource.data.homeroomClass == studentField(studentId, 'room', '__none__')
                       && request.resource.data.studentUid == studentField(studentId, 'studentUid', '__none__')
                       && request.resource.data.latitude is number
                       && request.resource.data.longitude is number
                       && request.resource.data.photoUrls.size() >= 1;

      allow delete: if false;
    }

    // 26. Department config — กลุ่มสาระฯ/กลุ่มงาน (แอดมินจัดการ)
    match /department_config/{deptId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN');
    }

    // 27. Elective activity config — ระบุว่า subjectCode ไหนเป็นชุมนุม/กิจกรรมตามความสนใจ
    // (ELECTIVE, สมัครเอง มีที่นั่งจำกัด) ต่างจากกิจกรรมยกห้อง (WHOLE_CLASS)
    match /elective_activities_config/{configId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN') || hasRole('ACADEMIC_HEAD');
    }

    // 28. Activity enrollments — การสมัคร/ถอนชุมนุมของนักเรียน (ไม่ลบ doc จริง mark removedAt แทน)
    // read กว้าง (isSignedIn) เพราะนักเรียนต้องเห็นจำนวนที่สมัครแล้วของ "คนอื่น" ด้วยเพื่อคำนวณที่นั่ง
    // เหลือ — ไม่ใช่ข้อมูลอ่อนไหวระดับเดียวกับสุขภาพจิต/การเงิน (แค่ว่าใครสมัครชุมนุมอะไร)
    match /activity_enrollments/{enrollmentId} {
      allow read: if isSignedIn();

      // สมัคร: สร้าง doc ของตัวเองเท่านั้น ต้องยังไม่ถอน (removedAt/removedBy ต้องเป็น null ตอนสร้าง)
      allow create: if hasRole('STUDENT')
                       && request.resource.data.studentUid == request.auth.uid
                       && request.resource.data.removedAt == null
                       && request.resource.data.removedBy == null
                       && studentField(request.resource.data.studentId, 'studentUid', '__none__') == request.auth.uid;

      // ถอน: แก้ได้เฉพาะ removedAt/removedBy/removedReason เท่านั้น — นักเรียนถอนตัวเอง
      // (removedBy ต้องเป็น null) หรือครูของ schedule นั้นถอน (removedBy ต้องเป็น uid ตัวเอง)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removedAt', 'removedBy', 'removedReason'])
                       && (
                         (hasRole('STUDENT') && resource.data.studentUid == request.auth.uid && request.resource.data.removedBy == null) ||
                         (
                           (hasRole('SUBJECT_TEACHER') || hasRole('HOMEROOM_TEACHER')) &&
                           request.resource.data.removedBy == request.auth.uid &&
                           isTeacherOfSchedule(resource.data.scheduleId)
                         ) ||
                         hasRole('SUPER_ADMIN')
                       );

      allow delete: if false;
    }

    // 28.1 Activity enrollment counts — ตัวนับที่นั่งต่อ scheduleId (derived, sync คู่กับ
    // activity_enrollments เสมอในทรานแซกชันเดียวกัน — ดู enrollInActivity/withdrawFromActivity)
    // จำเป็นเพราะ Firestore transaction อ่านได้แค่ document เดียว query ไม่ได้ ใช้ตัวนับนี้แทน
    // การนับจริงจาก activity_enrollments เพื่อตรวจที่นั่งแบบ atomic กัน race condition
    match /activity_enrollment_counts/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if (hasRole('STUDENT') || hasRole('SUBJECT_TEACHER') || hasRole('HOMEROOM_TEACHER') || hasRole('SUPER_ADMIN'))
                      && request.resource.data.count is int
                      && request.resource.data.count >= 0;
    }

    // 29. House config (คณะสี) — รากฐานสำหรับระบบคะแนนถ้วยในอนาคต ยังไม่มีการคำนวณคะแนนตอนนี้
    match /house_config/{houseId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN') || hasRole('ACADEMIC_HEAD');
    }

    // 30. Guidance Counseling Cases — เนื้อหาการให้คำปรึกษาจิตวิทยาของผู้เยาว์ ข้อมูลอ่อนไหวที่สุด
    // ในระบบ ตั้งใจให้เข้มงวดกว่า collection สุขภาพจิตอื่นๆ ทุกตัว: GUIDANCE_COUNSELOR/SUPER_ADMIN
    // เท่านั้น — ครูประจำชั้น ครูวิชาอื่น ผู้ปกครอง และตัวนักเรียนเจ้าของเคส "ห้ามอ่านได้" ทั้งหมด
    // (ต่างจาก student_screenings_2q/phq9/student_assessments_sdq ที่ยังให้ HOMEROOM_TEACHER/
    // self อ่านได้ — เคสนี้คือบันทึกการให้คำปรึกษาจริง ไม่ใช่แค่ผลคัดกรอง)
    match /guidance_counseling_cases/{caseId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR');
      // counselorUid ต้องตรงกับผู้เขียนจริงเสมอตอนสร้าง กันปลอมชื่อผู้บันทึก
      allow create: if (hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR')) &&
                       request.resource.data.counselorUid == request.auth.uid;
      allow update, delete: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR');
    }

    // Default Deny All Catch-All for unknown paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
