rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && (
        (request.auth.token.roles != null && role in request.auth.token.roles) ||
        (request.auth.token.primaryRole == role)
      );
    }

    function isSelf(userId) {
      return isSignedIn() && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    // school_settings/billing_payment: บัญชี/พร้อมเพย์ที่โรงเรียนรับโอน (ผู้ปกครองสร้าง QR จากค่านี้) — whitelist field + รูปแบบ
    // ให้ตรงกับ src/lib/billingPaymentInfo.ts + promptPay.ts (PHONE = 10 หลักขึ้นต้น 0, NATIONAL_ID = 13 หลัก, EWALLET = 15 หลัก)
    function isValidBillingPaymentInfo(d) {
      return d.keys().hasOnly(['promptPayType', 'promptPayId', 'accountName', 'bankName', 'bankAccountNo', 'note', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['promptPayType', 'promptPayId', 'accountName', 'bankName', 'bankAccountNo', 'note'])
        && d.promptPayType in ['NONE', 'PHONE', 'NATIONAL_ID', 'EWALLET']
        && d.promptPayId is string
        && ((d.promptPayType == 'NONE' && d.promptPayId == '')
          || (d.promptPayType == 'PHONE' && d.promptPayId.matches('^0[0-9]{9}$'))
          || (d.promptPayType == 'NATIONAL_ID' && d.promptPayId.matches('^[0-9]{13}$'))
          || (d.promptPayType == 'EWALLET' && d.promptPayId.matches('^[0-9]{15}$')))
        && d.accountName is string && d.accountName.size() <= 120
        && d.bankName is string && d.bankName.size() <= 120
        && d.bankAccountNo is string && d.bankAccountNo.size() <= 30
        && d.note is string && d.note.size() <= 300;
    }

    // school_settings/studentEmailFormat: ต้องมี prefix + domain ครบ (string, ตัวพิมพ์เล็ก) ผ่าน pattern เดียวกับ
    // functions/src/studentEmailFormat.ts และ src/lib/studentEmailFormat.ts และไม่มี field อื่นนอกจาก updatedAt/updatedBy
    function isValidStudentEmailFormat(d) {
      return d.keys().hasOnly(['prefix', 'domain', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['prefix', 'domain'])
        && d.prefix is string && d.prefix.matches('^[a-z0-9._-]{0,32}$')
        && d.domain is string && d.domain.size() <= 253
        && d.domain.matches('^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$');
    }

    // ปีการศึกษาที่ส่งมาต้องเป็นสตริง 4 หลักและตรงกับ school_settings/academic_year (ที่ admin ตั้งไว้) — doc ไม่มี = false
    function isCurrentAcademicYear(year) {
      return year is string && year.matches('^[0-9]{4}$')
        && exists(/databases/$(database)/documents/school_settings/academic_year)
        && get(/databases/$(database)/documents/school_settings/academic_year).data.academicYear == year;
    }

    // มีบทบาทอย่างน้อย 1 อย่างใน custom claims — claims ออกโดย blocking functions
    // (beforeUserCreated/beforeUserSignedIn) เท่านั้น: signed-in แต่ไม่มี roles = ไม่ใช่บุคลากร/นักเรียนในทะเบียน
    function hasAnyRole() {
      return isSignedIn()
        && request.auth.token.get('roles', []) is list
        && request.auth.token.get('roles', []).size() > 0;
    }

    // staff doc id ของผู้ใช้ (teacherId จากไฟล์ import — ไม่ใช่ Auth UID) จาก claim staffId
    function myStaffId() {
      return request.auth.token.get('staffId', '');
    }

    // ครูที่ปรึกษา (HOMEROOM_TEACHER) ของห้องที่ระบุ — เทียบ staff/{claims.staffId}.assignments.homeroomClass
    // (เดิมอ่าน staff/{auth.uid} ซึ่งไม่ตรงกับ staff ที่ import จริง — key เป็น teacherId)
    // ใช้ .get(k, default) กัน field ไม่มี
    function isHomeroomTeacherOf(roomValue) {
      return hasRole('HOMEROOM_TEACHER')
        && myStaffId() is string && myStaffId() != ''
        && exists(/databases/$(database)/documents/staff/$(myStaffId()))
        && get(/databases/$(database)/documents/staff/$(myStaffId())).data.get('assignments', {}).get('homeroomClass', '') == roomValue;
    }

    // ค่าจาก students/{studentId} จริง — ใช้ตอน create เพื่อกันนักเรียน denormalize ผิด
    function studentField(sid, key, fallback) {
      return get(/databases/$(database)/documents/students/$(sid)).data.get(key, fallback);
    }

    // นักเรียนเจ้าของ sid (5 หลัก) จริง — เทียบผ่าน students/{sid}.studentUid ไม่ใช่เทียบ
    // request.auth.uid กับ sid ตรงๆ (sid เป็นรหัสนักเรียน 5 หลัก ไม่ใช่ Firebase Auth UID เด็ดขาด
    // เทียบตรงจะไม่มีวันจริงสำหรับนักเรียนจริงสักคน — ดู student_screenings_2q/phq9 ด้านล่าง)
    function isSelfStudent(sid) {
      return isSignedIn() && studentField(sid, 'studentUid', '__none__') == request.auth.uid;
    }

    // ครูรับผิดชอบของชุมนุม (elective_activities_config) นี้จริง — เทียบ responsibleTeacherUid
    // ใช้ให้ครูถอนชื่อนักเรียนออกจากชุมนุม/กิจกรรม ELECTIVE ของตัวเองเท่านั้น (activity_enrollments)
    // (เดิมเทียบผ่าน schedules/{scheduleId}.teacherId — ออกแบบใหม่แล้วชุมนุมไม่ผูกกับ schedules อีกต่อไป)
    // รองรับครูร่วมสอนหลายคนต่อชุมนุม — responsibleTeacherUids เป็น array (เดิมเป็นค่าเดียว)
    // ⚠️ ชื่อฟิลด์มีคำว่า Uid แต่เก็บ staff doc id (teacherId) ไม่ใช่ Auth UID — เทียบด้วย myStaffId() เท่านั้น
    // ไม่มี fallback ไป request.auth.uid; ไม่มี claim staffId (นักเรียน/ผู้ปกครอง) = ไม่ผ่าน
    function isResponsibleTeacherOfActivity(activityId) {
      return isSignedIn()
        && myStaffId() is string && myStaffId() != ''
        && exists(/databases/$(database)/documents/elective_activities_config/$(activityId))
        && myStaffId() in get(/databases/$(database)/documents/elective_activities_config/$(activityId)).data.get('responsibleTeacherUids', []);
    }

    // 1. Students Collection
    // อ่านทะเบียนนักเรียนได้: บุคลากรที่ต้องใช้รายชื่อทั้งโรงเรียน (ครู/ผู้บริหาร/แนะแนว/พยาบาล/การเงิน/ศึกษานิเทศก์)
    // + ผู้ปกครองอ่านได้เฉพาะบุตรหลานตัวเอง (ต้อง query where('parentUid','==', uid) เพื่อให้ list ผ่าน)
    // + นักเรียนอ่านได้เฉพาะ record ของตัวเอง (ต้อง query where('studentUid','==', uid) เพื่อให้ list ผ่าน)
    match /students/{studentId} {
      allow read: if hasRole('SUPER_ADMIN') ||
                     hasRole('EXECUTIVE') ||
                     hasRole('SUBJECT_TEACHER') ||
                     hasRole('HOMEROOM_TEACHER') ||
                     hasRole('GUIDANCE_COUNSELOR') ||
                     hasRole('INFIRMARY_STAFF') ||
                     hasRole('FINANCE_STAFF') ||
                     hasRole('INSTRUCTIONAL_SUPERVISOR') ||
                     (isSignedIn() && resource.data.parentUid == request.auth.uid) ||
                     (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if hasRole('SUPER_ADMIN') || hasRole('HOMEROOM_TEACHER');
      // นักเรียนห้ามลบถาวรทุกกรณี (บันทึกการเช็คชื่อ/ผลประเมิน/ประวัติอ้างถึง) — เปลี่ยนสถานะแทน
      // (status/statusReason ดู src/lib/studentStatus.ts + ทะเบียนเลขประจำตัว student_id_registry)
      allow delete: if false;
      // TASK (รูปโปรไฟล์นักเรียน): นักเรียนแก้รูปของตัวเองได้เท่านั้น — จำกัดให้แตะได้แค่ photoUrl/
      // photoUpdatedAt (ตรวจ "ตัวเอง" ผ่าน isSelfStudent() เดียวกับที่ใช้ที่อื่น: students/{id}.studentUid
      // == auth.uid) ห้ามแก้ field อื่นของทะเบียนนักเรียน
      allow update: if hasRole('SUPER_ADMIN') || hasRole('HOMEROOM_TEACHER') ||
                       // ครูผู้สอนเช็คชื่อแล้ว sync ยอดสรุป (derived cache) ในทรานแซกชันเดียวกับ attendance_records —
                       // แตะได้แค่ field สถิติเหล่านี้เท่านั้น (ห้ามแก้ทะเบียนนักเรียนอื่น)
                       (
                         hasRole('SUBJECT_TEACHER') &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['attendanceStats', 'attendanceStatsUpdatedAt', 'courseAttendanceStats'])
                       ) ||
                       (
                         isSelfStudent(studentId) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrl', 'photoUpdatedAt'])
                       );
    }

    // ทะเบียนเลขประจำตัวนักเรียน: student_id_registry/{studentId} = { studentId, entries: [{heldBy, from, to, reason}] }
    // ประวัติผู้ถือเลข — เขียนโดยแอดมิน/ครูประจำชั้นผ่านการเปลี่ยนสถานะ/เพิ่มนักเรียนเท่านั้น; ห้ามลบ และห้ามทำให้ประวัติสั้นลง
    // (ข้อมูลระบุตัวบุคคล → อ่านได้เฉพาะ SUPER_ADMIN/HOMEROOM_TEACHER ไม่เปิด bare isSignedIn())
    match /student_id_registry/{registryId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('HOMEROOM_TEACHER');
      allow create: if (hasRole('SUPER_ADMIN') || hasRole('HOMEROOM_TEACHER')) &&
                       request.resource.data.studentId == registryId &&
                       request.resource.data.entries is list;
      allow update: if (hasRole('SUPER_ADMIN') || hasRole('HOMEROOM_TEACHER')) &&
                       request.resource.data.studentId == resource.data.studentId &&
                       request.resource.data.entries is list &&
                       request.resource.data.entries.size() >= resource.data.entries.size();
      allow delete: if false;

      // สำเนาเอกสารนักเรียนเดิมก่อนที่เลขประจำตัวถูกออกให้คนใหม่ (เพิ่มได้อย่างเดียว ห้ามแก้/ลบ)
      match /archived_records/{archiveId} {
        allow read: if hasRole('SUPER_ADMIN') || hasRole('HOMEROOM_TEACHER');
        allow create: if hasRole('SUPER_ADMIN') || hasRole('HOMEROOM_TEACHER');
        allow update, delete: if false;
      }
    }

    // 2. Mental Health & Counseling Self-Assessments (PHQ-9, SDQ)
    match /student_self_assessments/{studentId} {
      // TASK 9 (ExecutivePortal Learner Analytics): เพิ่ม EXECUTIVE อ่านได้ทั้งโรงเรียน — ฝั่ง UI
      // (ExecutiveLearnerAnalytics.tsx) รวมเป็นกราฟแจกแจง/เปอร์เซ็นต์เท่านั้น ไม่โชว์ผลรายบุคคล
      // นักเรียนเจ้าของเทียบผ่าน students/{studentId}.studentUid (isSelfStudent) — เดิมเทียบ auth.uid กับรหัสนักเรียน
      // ตรงๆ ซึ่งไม่มีวันจริง ทำให้นักเรียนจริงบันทึก/อ่านแบบประเมินของตัวเองไม่ได้ (ข้อมูลหายหลังส่ง)
      // ครูที่ปรึกษาอ่านได้เฉพาะห้องตัวเอง (homeroomClass denormalize ตอนนักเรียนบันทึก — ตรวจกับ students.room)
      allow read: if hasRole('SUPER_ADMIN') ||
                     hasRole('GUIDANCE_COUNSELOR') ||
                     hasRole('EXECUTIVE') ||
                     isSelfStudent(studentId) ||
                     (resource != null && isHomeroomTeacherOf(resource.data.homeroomClass)) ||
                     isSelf(resource.data.studentId) ||
                     isSelf(resource.data.studentUid);
      allow create, update: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') ||
                     (isSelfStudent(studentId)
                      && request.resource.data.studentId == studentId
                      && request.resource.data.homeroomClass == studentField(studentId, 'room', '__none__'));
      allow delete: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR');
    }

    // 3. Discipline & Behavior Logs
    match /discipline_logs/{logId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     hasRole('EXECUTIVE') || 
                     hasRole('GUIDANCE_COUNSELOR') ||
                     // นักเรียน/ผู้ปกครองอ่านประวัติคะแนนความประพฤติของตัวเอง/บุตรหลานได้ (ผูกด้วย uid ในเอกสาร
                     // ที่ updateBehaviorScoreAndTriggerAlert เขียน — รายการเก่าที่ไม่มี field นี้ = อ่านไม่ได้)
                     (isSignedIn() && (resource.data.get('studentUid', null) == request.auth.uid ||
                                       resource.data.get('parentUid', null) == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('SUBJECT_TEACHER') || 
                      hasRole('HOMEROOM_TEACHER');
    }

    // 4. Parent Notifications
    // FIX (ระบบแจ้งเตือนรวมศูนย์): เดิม write เป็น role-based ล้วน (SUPER_ADMIN/HOMEROOM_TEACHER/
    // SUBJECT_TEACHER) แต่การแจ้งเตือนหลายจุด (เช่น สแกนเข้า-ออกประตูโรงเรียน, ยื่นใบลา) ริเริ่มจาก
    // ตัวนักเรียน/ผู้ปกครองเอง (ดู GateAttendanceTracker.tsx) — เพิ่มช่องให้ STUDENT/PARENT สร้างแจ้งเตือน
    // ได้เฉพาะที่ parentUid ตรงกับผู้ปกครองจริงของ studentId ที่ระบุเท่านั้น (verify ผ่าน studentField()
    // กันสร้างแจ้งเตือนส่งให้ parentUid ใครก็ได้) และเพิ่มช่องให้เจ้าของกด "อ่านแล้ว" เอง (แก้ได้แค่ status)
    match /parent_notifications/{notifId} {
      // TASK: เพิ่ม studentUid ให้นักเรียนเจ้าของเรื่องอ่านแจ้งเตือนของตัวเองได้ด้วย (เดิมอ่านได้เฉพาะ
      // ผู้ปกครองที่ผูกไว้ผ่าน parentUid/parentId เท่านั้น) — ไม่กระทบ scope เดิมของผู้ปกครองเลย เป็นการ
      // เพิ่มเงื่อนไข OR ใหม่เท่านั้น
      allow read: if hasRole('SUPER_ADMIN') ||
                     hasRole('HOMEROOM_TEACHER') ||
                     (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.parentId == request.auth.uid)) ||
                     (isSignedIn() && resource.data.studentUid == request.auth.uid);

      // FIX: ตรวจแค่ "parentUid ที่ประกาศตรงกับพ่อแม่จริงของ studentId" ไม่พอ (ใครก็ประกาศ studentId/
      // parentUid ที่ถูกต้องของคนอื่นได้) ต้องตรวจด้วยว่า "ผู้เขียนเอง" เป็นตัวนักเรียนคนนั้นจริง
      // (isSelfStudent) หรือเป็นผู้ปกครองจริงของนักเรียนคนนั้น (auth.uid ตรงกับ parentUid จริง) เท่านั้น
      // TASK: studentUid ถ้าใส่มาด้วย ต้องตรงกับค่าจริงจาก students/{studentId}.studentUid เท่านั้น
      // (ห้ามประกาศ studentUid ของคนอื่นเพื่อแอบให้คนอื่นอ่านแจ้งเตือนได้ — ใช้กับทุก branch รวม role-based)
      allow create: if (
                       !('studentUid' in request.resource.data) ||
                       request.resource.data.studentUid == null ||
                       request.resource.data.studentUid == studentField(request.resource.data.studentId, 'studentUid', '__none__')
                     ) && (
                       hasRole('SUPER_ADMIN') ||
                       hasRole('HOMEROOM_TEACHER') ||
                       hasRole('SUBJECT_TEACHER') ||
                       hasRole('INFIRMARY_STAFF') ||
                       hasRole('FINANCE_STAFF') ||
                       hasRole('GUIDANCE_COUNSELOR') ||
                       (
                         request.resource.data.parentUid == studentField(request.resource.data.studentId, 'parentUid', '__none__') &&
                         (
                           isSelfStudent(request.resource.data.studentId) ||
                           (isSignedIn() && request.auth.uid == studentField(request.resource.data.studentId, 'parentUid', '__none__'))
                         )
                       )
                     );

      // ผู้ปกครอง หรือ นักเรียนเจ้าของเรื่องเอง กด "อ่านแล้ว"/"อ่านทั้งหมด" เอง — แก้ได้เฉพาะ field status เท่านั้น
      allow update: if hasRole('SUPER_ADMIN') ||
                       hasRole('HOMEROOM_TEACHER') ||
                       hasRole('SUBJECT_TEACHER') ||
                       (
                         isSignedIn() &&
                         (
                           resource.data.parentUid == request.auth.uid ||
                           resource.data.parentId == request.auth.uid ||
                           resource.data.studentUid == request.auth.uid
                         ) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                         request.resource.data.status in ['read', 'unread']
                       );

      allow delete: if hasRole('SUPER_ADMIN');
    }

    // 5. Parent-Teacher Conferences
    match /parent_conferences/{confId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.parentId == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || hasRole('HOMEROOM_TEACHER');
    }

    // 6. Timetables & Schedules
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN') || hasRole('HOMEROOM_TEACHER') || hasRole('SUBJECT_TEACHER');
    }

    // 7. Attendance Records
    match /attendance_records/{recordId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('EXECUTIVE') || 
                     hasRole('SUBJECT_TEACHER') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.studentUid == request.auth.uid || resource.data.studentId == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('SUBJECT_TEACHER') || 
                      hasRole('HOMEROOM_TEACHER');
    }

    // 8. Gradebook Scores
    match /gradebook_scores/{scoreId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('EXECUTIVE') || 
                     hasRole('SUBJECT_TEACHER') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     hasRole('HEAD_OF_DEPARTMENT') || 
                     (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.studentUid == request.auth.uid || resource.data.studentId == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') ||
                      hasRole('SUBJECT_TEACHER') ||
                      hasRole('HEAD_OF_DEPARTMENT');
    }

    // 8.1 Gradebook hidden courses (TASK 3) — คาบกิจกรรมที่ไม่ต้องประเมิน (เช่น PLC, พักกลางวัน)
    // ครูซ่อนออกจาก dropdown สมุดบันทึกคะแนนของตัวเองได้ (ไม่ลบข้อมูลจริง แค่ preference ส่วนตัว
    // ต่อครูคนเดียว) doc id = `${teacherUid}_${courseId}` — เจ้าของ (teacherUid ตรงกับ auth.uid) เท่านั้น
    // อ่าน/เขียนได้ ไม่ใช่ preference ระดับโรงเรียนที่ต้องให้ SUPER_ADMIN คุม
    match /gradebook_hidden_courses/{docId} {
      allow read: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow update: if false;
    }

    // 9. Admin Periods Configuration
    match /admin_periods_config/{periodId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN');
    }

    // 9.1 School Calendar (วันหยุดพิเศษ + วันเปิด-ปิดภาคเรียน) — แยกจาก school_settings/system_locks
    match /school_calendar_events/{eventId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN');
    }

    // 10. School Settings (periods_config, etc.)
    match /school_settings/{settingId} {
      allow read: if isSignedIn();
      // studentEmailFormat มี block เฉพาะด้านล่าง (ตรวจรูปแบบข้อมูลด้วย) — ต้องกันออกจาก wildcard นี้
      // เพราะ rules หลาย match block ใช้ OR กัน: ถ้าไม่กัน SUPER_ADMIN เขียนค่าอะไรก็ได้ผ่านทางนี้ ข้ามการตรวจรูปแบบ
      allow write: if hasRole('SUPER_ADMIN') && settingId != 'studentEmailFormat' && settingId != 'guidance_status' && settingId != 'billing_payment';
    }

    // 10.2 สถานะ "มีครูแนะแนวที่ใช้งานอยู่" — cache ที่ Cloud Functions คำนวณ (functions/src/guidanceStatus.ts) ใช้ตัดสินสิทธิ์อ่าน 9Q/8Q
    // ของครูที่ปรึกษา: client เขียนไม่ได้เด็ดขาด (แม้ SUPER_ADMIN) — Admin SDK ข้าม rules อยู่แล้ว ห้ามลบ settingId != 'guidance_status' ด้านบน
    match /school_settings/guidance_status {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 10.1 รูปแบบอีเมลนักเรียน {prefix}{studentId}@{domain} — client สร้างอีเมลตอนเพิ่มนักเรียน และ blocking function
    // (beforeUserCreated/SignedIn) ใช้จับคู่ตอน login จึงตรวจรูปแบบที่นี่ด้วย (admin SDK ของ function ข้าม rules —
    // function เองก็ sanitize + fallback เป็น it / utd.ac.th ถ้าค่าผิด) อ่านได้ทุกคนที่ signed-in เหมือน school_settings อื่น
    match /school_settings/studentEmailFormat {
      allow read: if isSignedIn();
      allow create, update: if hasRole('SUPER_ADMIN') && isValidStudentEmailFormat(request.resource.data);
      allow delete: if hasRole('SUPER_ADMIN');
    }

    // 10.3 บัญชีรับโอนเงินของโรงเรียน — อ่านได้ทุกคนที่ signed-in (ผู้ปกครอง/นักเรียนต้องเห็นเพื่อโอน) แก้ได้เฉพาะ SUPER_ADMIN
    // และต้องผ่าน isValidBillingPaymentInfo — ห้ามลบ settingId != 'billing_payment' ใน wildcard ด้านบน
    match /school_settings/billing_payment {
      allow read: if isSignedIn();
      allow create, update: if hasRole('SUPER_ADMIN') && isValidBillingPaymentInfo(request.resource.data);
      allow delete: if hasRole('SUPER_ADMIN');
    }

    // 11. Staff Directory
    match /staff/{staffId} {
      // ต้องมี roles ใน claims — signed-in เฉยๆ (ไม่อยู่ในทะเบียน) อ่านรายชื่อบุคลากรไม่ได้
      allow read: if hasAnyRole();
      allow write: if hasRole('SUPER_ADMIN');
    }

    // 12. Teachers Directory
    match /teachers/{teacherId} {
      // ต้องมี roles ใน claims — เหมือน staff
      allow read: if hasAnyRole();
      allow write: if hasRole('SUPER_ADMIN');
    }

    // 13. Seating Layouts & Subcollections (groups, seats)
    match /seating_layouts/{layoutId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN') || hasRole('SUBJECT_TEACHER') || hasRole('HOMEROOM_TEACHER');

      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if hasRole('SUPER_ADMIN') || hasRole('SUBJECT_TEACHER') || hasRole('HOMEROOM_TEACHER');
      }
    }

    // 14. Seating Assignments (History and Active)
    match /seating_assignments/{assignmentId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('EXECUTIVE') || 
                     hasRole('SUBJECT_TEACHER') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     (isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.parentUid == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('SUBJECT_TEACHER') || 
                      hasRole('HOMEROOM_TEACHER');
    }

    // 15. Gate Attendance Logs
    // record มี studentUid/parentUid denormalize ไว้ (ดู store.recordGateAttendance) — ครูที่ปรึกษา
    // query ทั้งวันได้ (HOMEROOM_TEACHER), ผู้ปกครอง query where('parentUid','==',uid), นักเรียน
    // query where('studentUid','==',uid) — studentId เป็นรหัส 5 หลัก ไม่ใช่ auth.uid จึงต้องเทียบ
    // ผ่าน studentUid/parentUid ที่ denormalize มา
    match /gate_attendance_logs/{logId} {
      allow read: if hasRole('SUPER_ADMIN') ||
                     hasRole('EXECUTIVE') ||
                     hasRole('HOMEROOM_TEACHER') ||
                     hasRole('SUBJECT_TEACHER') ||
                     (isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.studentUid == request.auth.uid || resource.data.parentUid == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') ||
                      hasRole('HOMEROOM_TEACHER') ||
                      hasRole('SUBJECT_TEACHER') ||
                      (isSignedIn() && (request.resource.data.studentId == request.auth.uid || request.resource.data.studentUid == request.auth.uid || request.resource.data.userId == request.auth.uid));
    }

    // 16. Detailed Leave Requests
    match /detailed_leave_requests/{leaveId} {
      // สายงาน (ตรงกับ src/lib/leaveFlow.ts):
      //   นักเรียนยื่น → PENDING_PARENT → (ผู้ปกครองรับทราบ) → PENDING_TEACHER → (ครูที่ปรึกษาห้องนั้น) → APPROVED/REJECTED
      //   ผู้ปกครองยื่น → PENDING_TEACHER ทันที; นักเรียนที่ยังไม่มีผู้ปกครองเชื่อมบัญชี → PENDING_TEACHER + noParentLinked
      // อ่าน: เจ้าของ (นักเรียน/ผู้ปกครอง) + ครูที่ปรึกษาห้องนั้น + SUPER_ADMIN/EXECUTIVE — query ต้องกรองด้วย
      // studentUid / parentUid / homeroomClass ตามผู้ดู
      allow read: if hasRole('SUPER_ADMIN') ||
                     hasRole('EXECUTIVE') ||
                     isHomeroomTeacherOf(resource.data.homeroomClass) ||
                     (isSignedIn() && (resource.data.studentUid == request.auth.uid || resource.data.parentUid == request.auth.uid));

      // สร้าง: ฟิลด์ครบ/ไม่เกิน + uid/ห้อง/ผู้ปกครองต้องตรง students/{studentId} จริง + สถานะเริ่มต้นตามผู้ยื่นเท่านั้น
      // (ห้ามยื่นเป็นสถานะ APPROVED/REJECTED เอง)
      allow create: if request.resource.data.keys().hasOnly([
                         'id', 'studentId', 'studentUid', 'parentUid', 'homeroomClass', 'leaveType', 'startDate', 'endDate',
                         'totalDays', 'reason', 'status', 'submittedByRole', 'submittedByUid', 'submittedBy', 'submittedAt',
                         'noParentLinked', 'parentAcknowledgedAt', 'updatedAt'])
                    && request.resource.data.keys().hasAll([
                         'id', 'studentId', 'studentUid', 'parentUid', 'homeroomClass', 'leaveType', 'startDate', 'endDate',
                         'totalDays', 'reason', 'status', 'submittedByRole', 'submittedByUid', 'submittedBy', 'submittedAt',
                         'noParentLinked', 'parentAcknowledgedAt'])
                    && request.resource.data.id == leaveId
                    && request.resource.data.studentUid == studentField(request.resource.data.studentId, 'studentUid', '__none__')
                    && request.resource.data.homeroomClass == studentField(request.resource.data.studentId, 'room', '__none__')
                    && request.resource.data.parentUid == studentField(request.resource.data.studentId, 'parentUid', null)
                    && request.resource.data.leaveType in ['SICK', 'PERSONAL', 'ACTIVITY', 'OTHER']
                    && request.resource.data.startDate is string && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.endDate is string && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.endDate >= request.resource.data.startDate
                    && request.resource.data.totalDays is int && request.resource.data.totalDays >= 1 && request.resource.data.totalDays <= 60
                    && request.resource.data.reason is string && request.resource.data.reason.size() >= 1 && request.resource.data.reason.size() <= 500
                    && request.resource.data.submittedByUid == request.auth.uid
                    && request.resource.data.parentAcknowledgedAt == null
                    && (
                      // นักเรียนยื่นเอง: มีผู้ปกครองเชื่อมบัญชี → รอผู้ปกครอง; ไม่มี → ส่งครูเลยพร้อมธงบอกเหตุผล
                      (isSelfStudent(request.resource.data.studentId)
                        && request.resource.data.submittedByRole == 'student'
                        && ((request.resource.data.parentUid != null
                              && request.resource.data.status == 'PENDING_PARENT'
                              && request.resource.data.noParentLinked == false)
                            || (request.resource.data.parentUid == null
                              && request.resource.data.status == 'PENDING_TEACHER'
                              && request.resource.data.noParentLinked == true)))
                      // ผู้ปกครองตัวจริงของนักเรียนยื่นแทน: ส่งถึงครูที่ปรึกษาทันที
                      || (request.resource.data.parentUid != null
                        && request.auth.uid == request.resource.data.parentUid
                        && request.resource.data.submittedByRole == 'parent'
                        && request.resource.data.status == 'PENDING_TEACHER'
                        && request.resource.data.noParentLinked == false)
                    );

      allow update: if (
                        // ผู้ปกครองตัวจริงกด "รับทราบ" ใบที่นักเรียนยื่น: รอผู้ปกครอง → รอครู เท่านั้น
                        isSignedIn() && resource.data.parentUid != null && request.auth.uid == resource.data.parentUid
                        && resource.data.status == 'PENDING_PARENT'
                        && request.resource.data.status == 'PENDING_TEACHER'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'parentAcknowledgedAt', 'parentAcknowledgedBy', 'updatedAt'])
                        && request.resource.data.parentAcknowledgedAt is string
                        && request.resource.data.parentAcknowledgedBy == request.auth.uid
                      ) || (
                        // ครูที่ปรึกษาห้องนั้น (หรือ SUPER_ADMIN) ตัดสิน เฉพาะใบที่ผ่านขั้นผู้ปกครองแล้ว (ข้ามขั้นไม่ได้)
                        (hasRole('SUPER_ADMIN') || isHomeroomTeacherOf(resource.data.homeroomClass))
                        && resource.data.status == 'PENDING_TEACHER'
                        && request.resource.data.status in ['APPROVED', 'REJECTED']
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'teacherRemarks', 'decidedBy', 'decidedByStaffId', 'decidedAt', 'updatedAt'])
                        && request.resource.data.decidedBy is string && request.resource.data.decidedBy.size() > 0
                        && request.resource.data.teacherRemarks is string && request.resource.data.teacherRemarks.size() <= 500
                      );
      // ลบไม่ได้ (เป็นหลักฐานการลา)
      allow delete: if false;
    }

    // 16b. วันที่นักเรียนลาที่อนุมัติแล้ว — สำเนา "ไม่มีเหตุผลการลา" ให้ครูผู้สอนเห็นสถานะ "ลา" ตอนเช็คชื่อ
    // เหตุผล/ประเภทการลา (อาจเป็นข้อมูลสุขภาพ) อยู่ใน detailed_leave_requests ซึ่งครูประจำวิชาอ่านไม่ได้
    // สร้างได้เฉพาะพร้อมกับการอนุมัติใบลาจริง (batch เดียวกัน — ตรวจด้วย getAfter) และข้อมูลต้องตรงใบลา; แก้/ลบไม่ได้
    match /student_leave_days/{leaveId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('EXECUTIVE') || hasRole('HOMEROOM_TEACHER') || hasRole('SUBJECT_TEACHER');
      allow create: if request.resource.data.keys().hasOnly(['leaveId', 'studentId', 'homeroomClass', 'startDate', 'endDate', 'createdAt'])
                    && request.resource.data.leaveId == leaveId
                    && getAfter(/databases/$(database)/documents/detailed_leave_requests/$(leaveId)).data.status == 'APPROVED'
                    && get(/databases/$(database)/documents/detailed_leave_requests/$(leaveId)).data.status == 'PENDING_TEACHER'
                    && request.resource.data.studentId == getAfter(/databases/$(database)/documents/detailed_leave_requests/$(leaveId)).data.studentId
                    && request.resource.data.homeroomClass == getAfter(/databases/$(database)/documents/detailed_leave_requests/$(leaveId)).data.homeroomClass
                    && request.resource.data.startDate == getAfter(/databases/$(database)/documents/detailed_leave_requests/$(leaveId)).data.startDate
                    && request.resource.data.endDate == getAfter(/databases/$(database)/documents/detailed_leave_requests/$(leaveId)).data.endDate;
      allow update, delete: if false;
    }

    // 17. GPS Check-in Logs
    match /gps_check_in_logs/{logId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('EXECUTIVE') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     hasRole('SUBJECT_TEACHER') || 
                     (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.studentId == request.auth.uid || resource.data.parentUid == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('HOMEROOM_TEACHER') || 
                      hasRole('SUBJECT_TEACHER') || 
                      (isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.studentId == request.auth.uid));
    }

    // 18. Substitute Teaching Assignments & Post Teaching Records
    // TODO(security): ตอนนี้ write เป็น role-based ล้วน (ยังบังคับลำดับ 4 ขั้นที่ layer นี้ไม่ได้).
    //   หลัง workflow ฝั่ง client verify ผ่าน emulator แล้ว ให้เพิ่มการตรวจ:
    //   - อนุมัติได้เฉพาะเมื่อ request.resource.data.currentApprovalStage ตรงกับ role ผู้เขียน
    //     (STAGE_1→HEAD_OF_DEPARTMENT, STAGE_2→ACADEMIC_HEAD, STAGE_3→DEPUTY_DIRECTOR_ACADEMIC, STAGE_4→DIRECTOR)
    //   - currentApprovalStage เดินหน้าได้ทีละขั้น (ห้ามข้าม), ห้าม downgrade
    //   - SUBJECT_TEACHER แก้ได้เฉพาะ field ชุด completion* / isCompleted / completedAt เท่านั้น
    match /substitute_assignments/{assignmentId} {
      allow read: if isSignedIn();
      // SUBJECT_TEACHER/HOMEROOM_TEACHER เขียนได้เพื่อรองรับครูขอลากิจ/ไปราชการด้วยตนเอง
      // (สถานะเริ่มต้นล็อกที่ STAGE_1_HEAD_OF_DEPARTMENT เสมอในโค้ด client — ดู proposeSubstituteAssignment)
      allow write: if hasRole('SUPER_ADMIN') ||
                      hasRole('HEAD_OF_DEPARTMENT') ||
                      hasRole('ACADEMIC_HEAD') ||
                      hasRole('DEPUTY_DIRECTOR_ACADEMIC') ||
                      hasRole('DIRECTOR') ||
                      hasRole('EXECUTIVE') ||
                      hasRole('SUBJECT_TEACHER') ||
                      hasRole('HOMEROOM_TEACHER');
    }

    // log การนำเข้าภาระงานสอน (Bulk Import COURSE): ใครนำเข้า เปลี่ยนครู/เก็บกวาดตารางอะไร และใครเคยเป็นผู้บันทึก
    // เพิ่มอย่างเดียว (append-only) — SUPER_ADMIN สร้างได้โดยระบุ importedByUid เป็นของตัวเองเท่านั้น; แก้/ลบไม่ได้ทุกบทบาท
    // อ่านได้เฉพาะผู้ดูแลระบบและผู้บริหารฝ่ายวิชาการ (ไม่เปิดให้ signed-in ทั่วไป)
    match /schedule_import_logs/{logId} {
      allow read: if hasRole('SUPER_ADMIN') ||
                     hasRole('ACADEMIC_HEAD') ||
                     hasRole('DEPUTY_DIRECTOR_ACADEMIC') ||
                     hasRole('DIRECTOR');
      allow create: if hasRole('SUPER_ADMIN') &&
                       request.resource.data.importedByUid == request.auth.uid &&
                       request.resource.data.type == 'TEACHING_LOAD_IMPORT';
      allow update, delete: if false;
    }

    match /post_teaching_records/{recordId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('HEAD_OF_DEPARTMENT') || 
                      hasRole('ACADEMIC_HEAD') || 
                      hasRole('DEPUTY_DIRECTOR_ACADEMIC') || 
                      hasRole('DIRECTOR') || 
                      hasRole('EXECUTIVE') || 
                      hasRole('SUBJECT_TEACHER');
    }

    // 19. Student Health & Mental Screenings (2Q, PHQ-9, SDQ)
    // FIX: doc id {studentId} คือรหัสนักเรียน 5 หลัก (ดู save2QScreeningFirestore/savePHQ9ScreeningFirestore
    // ใน firestoreService.ts) ไม่ใช่ Firebase Auth UID — isSelf(studentId) เดิมเทียบ auth.uid กับรหัส 5 หลัก
    // ตรงๆ จึงไม่มีวันจริงเลย ทำให้นักเรียนทำแบบคัดกรองของตัวเองไม่ผ่าน rules เงียบๆ (เห็นเหมือนบันทึกสำเร็จ
    // ฝั่ง UI เพราะ optimistic local state แต่ Firestore ปฏิเสธจริง) แก้เป็น isSelfStudent() ที่เทียบผ่าน
    // students/{studentId}.studentUid จริงแทน — ไม่ได้เปลี่ยนว่าใครมีสิทธิ์ (ยังเป็นเจ้าของตัวเอง/
    // ครูประจำชั้น/ครูแนะแนว/แอดมินเหมือนเดิม) แค่แก้วิธีตรวจว่า "ตัวเอง" ให้ตรงกับที่ระบบตั้งใจไว้จริง
    // TASK 5 (ExecutivePortal Health, ยืนยันจากผู้ใช้): เพิ่ม EXECUTIVE อ่านได้ทั้งโรงเรียน เพื่อสรุป
    // ภาพรวมระดับโรงเรียน (นับจำนวน ไม่ระบุตัวบุคคล) — Firestore ไม่มี field-level redaction ฝั่ง UI
    // ต้องรวมเป็นตัวเลขสรุปเท่านั้น ห้ามโชว์ผลรายบุคคล
    // ═══ คัดกรองซึมเศร้า/ฆ่าตัวตาย ตามลำดับ 2Q → 9Q → 8Q (คู่มือกรมสุขภาพจิต/สพฐ.) ═══
    // ข้อมูลอ่อนไหวที่สุดของเด็ก. Firestore ไม่มีสิทธิ์ระดับ field (ครูที่ปรึกษาต้องเห็นแค่ "ระดับความเสี่ยง"
    // ไม่เห็นคำตอบ/คะแนนดิบ) จึงแยกเอกสารตามระดับการมองเห็น:
    //   student_screenings_2q            2Q ล่าสุด (นักเรียนทำเองอิสระได้) — ครูแนะแนว + ครูที่ปรึกษาของห้องอ่านเต็ม
    //   student_screenings_9q            9Q "สรุป": riskLevel + ธงแดงข้อ 9 (ไม่มีคะแนน/คำตอบ)   ← เขียนผ่าน callable submitNineQ เท่านั้น
    //   student_screenings_9q_detail     9Q คำตอบรายข้อ + คะแนนรวม — ครูแนะแนวเสมอ; ครูที่ปรึกษาเฉพาะเมื่อไม่มีครูแนะแนวที่ใช้งานอยู่  ← เช่นกัน
    //   student_screening_progress       ฐานที่ใช้ทำ 9Q ไปแล้ว (usedBasisIds) — ไม่มีคะแนน นักเรียนอ่านของตัวเองได้  ← เช่นกัน
    //     └ grants/{grantId}             ใบอนุญาตที่ครูเปิดให้นักเรียนทำ 9Q (ครูเขียนจาก client ได้ — ไม่มีคะแนน)
    //   student_screenings_8q            8Q คะแนน/คำตอบ (ครูกรอกแทนนักเรียน) — สิทธิ์เหมือน 9Q detail; rules ตรวจคะแนน/ระดับ/ส่งต่อด่วนซ้ำเอง
    //   student_8q_case_flags            8Q "มีเคสอยู่ในการดูแล ใช่/ไม่" (ไม่มีคะแนน) — ครูที่ปรึกษาเห็นได้เสมอ
    //   student_screening_notices/{sid}/entries  บันทึก "แจ้งผู้ปกครองแล้ว" (ใครแจ้ง/เมื่อไร/วิธีไหน) append-only
    // นักเรียนอ่านได้เฉพาะ 2Q ของตัวเอง (+ progress/grants ของตัวเอง) — ห้ามอ่าน 9Q/8Q ทุกชนิด
    // ครูที่ปรึกษา = HOMEROOM_TEACHER "ของห้องนั้น" (เทียบ staff.assignments.homeroomClass กับ students/{id}.room)

    // ห้องของนักเรียนอยู่ในความดูแลของครูที่ปรึกษาคนนี้
    function isHomeroomOfStudent(sid) {
      return isHomeroomTeacherOf(studentField(sid, 'room', '__none__'));
    }

    // มีครูแนะแนวที่ใช้งานอยู่ในระบบไหม — rules ค้นหา staff ตาม role ด้วย query ไม่ได้ จึงอ่านจาก cache
    // school_settings/guidance_status ที่ Cloud Functions คำนวณให้ (functions/src/guidanceStatus.ts; client เขียนไม่ได้)
    // ⚠️ fail-closed: doc ไม่มี/ไม่มีฟิลด์ = ถือว่า "มีครูแนะแนว" (ครูที่ปรึกษาเห็นแค่ระดับ) ไม่ใช่ "ไม่มี" (เห็นเต็ม)
    function hasActiveGuidanceCounselor() {
      return !exists(/databases/$(database)/documents/school_settings/guidance_status)
        || get(/databases/$(database)/documents/school_settings/guidance_status).data.get('hasActiveCounselor', true) == true;
    }

    // ครูที่ปรึกษาของห้องนี้ที่ "ทำแทนครูแนะแนว" ได้ — เฉพาะเมื่อไม่มีครูแนะแนวที่ใช้งานอยู่เลย
    function isHomeroomActingAsCounselor(sid) {
      return isHomeroomOfStudent(sid) && !hasActiveGuidanceCounselor();
    }

    // ผู้เขียน 8Q (ครูกรอกแทนนักเรียน ไม่ใช่นักเรียน): ครูแนะแนวเสมอ; ครูที่ปรึกษาเฉพาะเมื่อไม่มีครูแนะแนวที่ใช้งานอยู่
    // ⚠️ ทางฉุกเฉิน: บันทึกได้ "เสมอ" ไม่ต้องมี 9Q ≥7/ธงแดงมาก่อน (เงื่อนไขนั้นเป็นแค่เหตุผลที่ระบบแนะนำให้ทำ 8Q — ไม่ใช่ตัวบล็อก)
    // เพราะครูที่เจอเด็กวิกฤตต้องบันทึกได้ทันที
    function canWriteEightQ(sid) {
      return hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomActingAsCounselor(sid);
    }

    // 8Q: rules คำนวณคะแนน/ระดับ/ส่งต่อด่วนซ้ำจากคำตอบดิบเอง (ไม่เชื่อค่าที่ client ส่งมา) — ผู้กรอกเป็นครู (ผู้มีสิทธิ์อ่านผลอยู่แล้ว)
    // จึงไม่ต้องใช้ Cloud Function เหมือน 9Q ที่นักเรียนส่งเอง. คะแนนต่อข้อ: 1,2,6,8,9,4,10,4; ข้อ 3 ตอบ "มี" + ควบคุมความคิดไม่ได้ = +8
    // ระดับ: 0 NONE, 1-8 LOW, 9-16 MODERATE, ≥17 SEVERE (= ส่งต่อโรงพยาบาลด่วน)
    function eightQIntegrityOk(d) {
      let a = d.answers;
      let base = (a[0] ? 1 : 0) + (a[1] ? 2 : 0) + (a[2] ? 6 : 0) + (a[3] ? 8 : 0) + (a[4] ? 9 : 0) + (a[5] ? 4 : 0) + (a[6] ? 10 : 0) + (a[7] ? 4 : 0);
      let follow = (a[2] == true && d.q3CanControl == false) ? 8 : 0;
      return a.size() == 8
        && a[0] is bool && a[1] is bool && a[2] is bool && a[3] is bool && a[4] is bool && a[5] is bool && a[6] is bool && a[7] is bool
        && ((a[2] == true && d.q3CanControl is bool) || (a[2] == false && d.q3CanControl == null))
        && d.totalScore is int && d.totalScore == base + follow
        && d.riskLevel == (d.totalScore == 0 ? 'NONE' : (d.totalScore <= 8 ? 'LOW' : (d.totalScore <= 16 ? 'MODERATE' : 'SEVERE')))
        && d.urgentReferral == (d.totalScore >= 17);
    }

    // 2Q: นักเรียนทำเองอิสระได้ (ไม่จำกัดรอบ); ครูแนะแนวและครูที่ปรึกษาของห้องอ่านเต็มเสมอ
    // EXECUTIVE อ่านได้เพื่อสรุปภาพรวมโรงเรียน (นับจำนวน ไม่ระบุตัวบุคคล — ฝั่ง UI ต้องรวมเป็นตัวเลขเท่านั้น)
    match /student_screenings_2q/{studentId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || hasRole('EXECUTIVE') || isHomeroomOfStudent(studentId) || isSelfStudent(studentId);
      allow write: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomOfStudent(studentId) || isSelfStudent(studentId);
    }

    // PHQ-9 สากลเดิม (เลิกใช้แล้ว — แทนด้วย 9Q ไทย): เก็บข้อมูลเก่าไว้อ่านได้เฉพาะครูแนะแนว/แอดมิน
    // ห้ามเขียนเพิ่ม ห้ามนักเรียน/ครูที่ปรึกษา/ผู้บริหารอ่าน
    match /student_screenings_phq9/{studentId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR');
      allow write: if false;
    }

    // 9Q — สรุป (ระดับความเสี่ยง + ธงแดงข้อ 9 เท่านั้น ไม่มีคะแนนรวม/คำตอบ): ครูที่ปรึกษาของห้องอ่านได้เสมอ
    // ⚠️ client เขียนไม่ได้เด็ดขาด (แม้ครูแนะแนว/SUPER_ADMIN) — ต้องผ่าน callable submitNineQ (Admin SDK ข้าม rules) ซึ่งคำนวณ
    // riskLevel/ธงแดงเองจากคำตอบดิบ + ตรวจสิทธิ์/ฐานการทำเอง (functions/src/nineQSubmit.ts) ไม่เชื่อค่าที่ client ส่ง
    match /student_screenings_9q/{studentId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomOfStudent(studentId);
      allow write: if false;
    }

    // 9Q — รายละเอียด (คำตอบรายข้อ + คะแนนรวม): ครูแนะแนวเสมอ; ครูที่ปรึกษาเมื่อไม่มีครูแนะแนวที่ใช้งานอยู่เท่านั้น — เขียนผ่าน submitNineQ เท่านั้น
    match /student_screenings_9q_detail/{studentId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomActingAsCounselor(studentId);
      allow write: if false;
    }

    // ฐานที่ใช้ทำ 9Q ไปแล้ว — นักเรียนอ่านของตัวเองได้ (เพื่อรู้ว่าทำฐานนี้ไปแล้ว) ไม่มีคะแนน/ระดับใดๆ — เขียนผ่าน submitNineQ เท่านั้น
    match /student_screening_progress/{studentId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomOfStudent(studentId) || isSelfStudent(studentId);
      allow write: if false;

      // ใบอนุญาตให้นักเรียนทำ 9Q — ครูแนะแนว/ครูที่ปรึกษาของห้องเปิดให้ (นักเรียนเปิดเองไม่ได้); นักเรียนอ่านของตัวเอง
      match /grants/{grantId} {
        allow read: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomOfStudent(studentId) || isSelfStudent(studentId);
        allow create: if (hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomOfStudent(studentId))
          && request.resource.data.keys().hasOnly(['openedByUid', 'openedByName', 'openedByRole', 'openedAt', 'note'])
          && request.resource.data.openedByUid == request.auth.uid;
        // เพิกถอนใบอนุญาตที่ยังไม่ถูกใช้ (ลบ) — ครูแนะแนว/ครูที่ปรึกษาของห้อง; แก้ไขไม่ได้
        allow delete: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomOfStudent(studentId);
        allow update: if false;
      }
    }

    // 8Q — คะแนน/คำตอบ (ครูกรอกแทนนักเรียนระหว่างพูดคุย ไม่มีหน้าจอให้นักเรียนทำเอง — นักเรียนอ่าน/เขียนไม่ได้เด็ดขาด)
    // entryPath: AFTER_9Q = ทำตามลำดับปกติ (9Q ≥7/ธงแดง) | EMERGENCY = ทางฉุกเฉิน ประเมินทันทีโดยไม่ต้องรอ 9Q (เก็บไว้ตรวจย้อนหลัง)
    match /student_screenings_8q/{studentId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomActingAsCounselor(studentId);
      allow create, update: if canWriteEightQ(studentId)
        && request.resource.data.keys().hasOnly(['id', 'studentId', 'answers', 'q3CanControl', 'totalScore', 'riskLevel', 'urgentReferral', 'entryPath', 'conductedAt', 'recordedByUid', 'recordedByName', 'updatedAt'])
        && request.resource.data.studentId == studentId
        && request.resource.data.recordedByUid == request.auth.uid
        && request.resource.data.entryPath in ['AFTER_9Q', 'EMERGENCY']
        && eightQIntegrityOk(request.resource.data);
      allow delete: if hasRole('SUPER_ADMIN');
    }

    // 8Q — "มีเคสอยู่ในการดูแล ใช่/ไม่" เท่านั้น (ไม่มีคะแนน) ครูที่ปรึกษาของห้องเห็นได้เสมอแม้มีครูแนะแนว
    // hasCase ต้องตรงกับ 8Q ที่เขียนใน batch เดียวกัน (คะแนน > 0) — กันตั้งค่าไม่ตรงกับผลจริง
    match /student_8q_case_flags/{studentId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomOfStudent(studentId);
      allow create, update: if canWriteEightQ(studentId)
        && request.resource.data.keys().hasOnly(['studentId', 'hasCase', 'updatedByUid', 'updatedAt'])
        && request.resource.data.studentId == studentId
        && request.resource.data.hasCase is bool
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.hasCase == (getAfter(/databases/$(database)/documents/student_screenings_8q/$(studentId)).data.totalScore > 0);
      allow delete: if hasRole('SUPER_ADMIN');
    }

    // บันทึก "แจ้งผู้ปกครองแล้ว" — ไม่ส่งแจ้งเตือนอัตโนมัติ ครูกรอกเองหลังติดต่อจริง; append-only (แก้ไม่ได้)
    // การแจ้งเรื่อง 8Q: ครูแนะแนวเสมอ; ครูที่ปรึกษาเฉพาะเมื่อไม่มีครูแนะแนวที่ใช้งานอยู่
    match /student_screening_notices/{studentId}/entries/{entryId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomOfStudent(studentId);
      allow create: if (hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomOfStudent(studentId))
        && request.resource.data.keys().hasOnly(['scope', 'screeningId', 'notifiedByUid', 'notifiedByName', 'notifiedAt', 'method', 'note'])
        && request.resource.data.scope in ['NINE_Q', 'EIGHT_Q']
        && request.resource.data.method in ['PHONE', 'IN_PERSON', 'MESSAGE', 'OTHER']
        && request.resource.data.notifiedByUid == request.auth.uid
        && (request.resource.data.scope == 'NINE_Q' || hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomActingAsCounselor(studentId));
      allow update: if false;
      allow delete: if hasRole('SUPER_ADMIN');
    }

    // บันทึก "พบนักเรียนแล้ว" หลัง 9Q ธงแดง — ครูแนะแนว/ครูที่ปรึกษาของห้องเขียนหลังพบจริง; append-only (แก้ไม่ได้)
    // ใช้ปิดงานในกระดิ่ง (คู่กับ "แจ้งผู้ปกครองแล้ว") ไม่มีผลคัดกรองใดๆ อยู่ในเอกสารนี้
    match /student_screening_followups/{studentId}/entries/{entryId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomOfStudent(studentId);
      allow create: if (hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR') || isHomeroomOfStudent(studentId))
        && request.resource.data.keys().hasOnly(['kind', 'screeningId', 'metByUid', 'metByName', 'metAt', 'note'])
        && request.resource.data.keys().hasAll(['kind', 'screeningId', 'metByUid', 'metByName', 'metAt'])
        && request.resource.data.kind == 'STUDENT_MET'
        && request.resource.data.screeningId is string && request.resource.data.screeningId.size() > 0
        && request.resource.data.metByUid == request.auth.uid
        && request.resource.data.metByName is string && request.resource.data.metByName.size() > 0
        && request.resource.data.metAt is string
        && (!('note' in request.resource.data.keys()) || (request.resource.data.note is string && request.resource.data.note.size() <= 500));
      allow update: if false;
      allow delete: if hasRole('SUPER_ADMIN');
    }

    // FIX (ยืนยันจากโรงเรียน): SDQ กรอกได้ 3 กลุ่ม — นักเรียนประเมินตนเอง/ผู้ปกครอง/ครูที่ปรึกษา
    // ของห้องนั้นจริง (ต่างจาก 2Q/PHQ-9 ที่นักเรียนประเมินตนเองอย่างเดียว) เดิม rule เช็คแค่
    // self-attestation (request.resource.data.evaluatorId == auth.uid) — ผู้เขียนระบุ uid ตัวเองใน
    // เอกสารเฉยๆ ไม่เคยตรวจว่าเป็นความสัมพันธ์จริงกับนักเรียนคนนั้นเลย (ผู้ปกครอง/ครูคนไหนก็เขียนให้
    // เด็กคนไหนก็ได้แค่ใส่ evaluatorId เป็น uid ตัวเอง) แก้เป็นตรวจสอบจริงผ่าน students/{studentId}
    match /student_assessments_sdq/{sdqId} {
      allow read: if hasRole('SUPER_ADMIN') ||
                     hasRole('GUIDANCE_COUNSELOR') ||
                     hasRole('HOMEROOM_TEACHER') ||
                     hasRole('EXECUTIVE') ||
                     (isSignedIn() && (resource.data.studentUid == request.auth.uid || resource.data.respondentUid == request.auth.uid));

      // studentUid ต้อง denormalize ตรงกับ students/{studentId} จริงเสมอ (ไม่ว่าใครเป็นผู้กรอก)
      // และ respondentUid ต้องเป็นผู้เขียนจริง แล้วผู้เขียนต้องเป็นหนึ่งใน 3 กลุ่มที่ยืนยันความสัมพันธ์
      // จริงได้: (1) ตัวนักเรียนเอง (2) ผู้ปกครองของนักเรียนคนนั้นจริง (3) ครูที่ปรึกษาของห้องนั้นจริง
      //
      // ปีการศึกษา + กันกรอกซ้ำ (ผู้กรอก 3 กลุ่ม — SUPER_ADMIN/GUIDANCE_COUNSELOR ไม่ถูกจำกัดตรงนี้ ตามเดิม):
      //  - academicYear ต้องตรงกับ school_settings/academic_year ปัจจุบันจริง (ไม่มีตั้งค่า = ปฏิเสธ ไม่เดาปีให้)
      //  - doc id ต้องเป็น {studentId}_{evaluatorType}_{academicYear} ตายตัว → 1 ชุดต่อ (นักเรียน, ผู้ประเมิน, ปี)
      //    rules ค้นเอกสารซ้ำด้วย query ไม่ได้ แต่ id ตายตัวทำให้การสร้างซ้ำคือการ "ทับ doc เดิม" = update ซึ่งผู้กรอก
      //    ทำไม่ได้ (allow update ด้านล่างเฉพาะ SUPER_ADMIN/GUIDANCE_COUNSELOR) และสร้างด้วย id อื่นก็ไม่ผ่านเงื่อนไข id
      allow create: if hasRole('SUPER_ADMIN') ||
                       hasRole('GUIDANCE_COUNSELOR') ||
                       (
                         isCurrentAcademicYear(request.resource.data.academicYear) &&
                         sdqId == request.resource.data.studentId + '_' + request.resource.data.evaluatorType + '_' + request.resource.data.academicYear &&
                         // นักเรียนที่ยังไม่เชื่อมบัญชี (ไม่มี field studentUid) → ส่ง '' (ครูที่ปรึกษากรอกให้ได้ ไม่ต้องรอเชื่อมบัญชี);
                         // นักเรียนที่เชื่อมแล้วต้องตรงกับค่าจริงเสมอ — เทียบกับ doc ที่ไม่มีอยู่ get() จะ error = ปฏิเสธ
                         request.resource.data.studentUid == studentField(request.resource.data.studentId, 'studentUid', '') &&
                         request.resource.data.respondentUid == request.auth.uid &&
                         // ผู้กรอกต้องกรอกได้เฉพาะ "มุมมองของตัวเอง" — นักเรียนกรอกได้แค่ STUDENT, ผู้ปกครองแค่ PARENT,
                         // ครูที่ปรึกษาแค่ TEACHER (กันนักเรียนกรอกแทนครู/ผู้ปกครองแล้วล็อกการกรอกของจริงทั้งปี
                         // เพราะ doc id ตายตัวต่อ (นักเรียน, ผู้ประเมิน, ปี))
                         (
                           (request.resource.data.evaluatorType == 'STUDENT' &&
                            isSelfStudent(request.resource.data.studentId)) ||
                           (request.resource.data.evaluatorType == 'PARENT' && isSignedIn() &&
                            request.auth.uid == studentField(request.resource.data.studentId, 'parentUid', '__none__')) ||
                           (request.resource.data.evaluatorType == 'TEACHER' &&
                            isHomeroomTeacherOf(studentField(request.resource.data.studentId, 'room', '__none__')))
                         )
                       );

      // แก้ไข/ลบผลประเมินที่ส่งไปแล้ว: เฉพาะ SUPER_ADMIN/GUIDANCE_COUNSELOR เท่านั้น (ผู้กรอกเดิม
      // แก้ย้อนหลังเองไม่ได้ — ป้องกันการแก้ผลหลังส่ง เหมือน guidance_counseling_cases/infirmary_visits)
      allow update, delete: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR');
    }

    // 20. Billing Invoices, Messages, and Appointments
    // FIX (เฟส 2 การเงิน — TASK 1): เดิมไม่มีฟีเจอร์สร้างใบแจ้งหนี้อยู่เลย และ read/write เดิมเทียบ
    // resource.data.studentId == auth.uid ตรงๆ (studentId เป็นรหัสนักเรียน 5 หลัก ไม่ใช่ Firebase
    // Auth UID เด็ดขาด — บั๊กเดียวกับที่พบใน student_screenings_2q/phq9 มาก่อน) แก้เป็นเทียบผ่าน
    // studentUid ที่ denormalize+validate จริงตอนสร้างแทน — เขียน/แก้ไข เฉพาะ FINANCE_STAFF/
    // SUPER_ADMIN เท่านั้น (การชำระเงินของเจ้าของเอง ดู TASK 3 ที่จะเพิ่ม allow update แยกต่างหาก)
    match /billing_counters/{academicYear} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('FINANCE_STAFF');
      allow write: if hasRole('SUPER_ADMIN') || hasRole('FINANCE_STAFF');
    }

    match /billing_invoices/{invoiceId} {
      allow read: if hasRole('SUPER_ADMIN') ||
                     hasRole('FINANCE_STAFF') ||
                     hasRole('EXECUTIVE') ||
                     (isSignedIn() && (resource.data.studentUid == request.auth.uid || resource.data.parentUid == request.auth.uid));

      // studentUid/parentUid ต้อง denormalize ตรงกับ students/{studentId} จริงเสมอ (กันเจ้าหน้าที่
      // การเงินพิมพ์ผิดแล้วส่งบิลไปให้ผู้ปกครองคนละครอบครัวเห็น) และ createdBy ต้องเป็นผู้เขียนจริง
      allow create: if (hasRole('SUPER_ADMIN') || hasRole('FINANCE_STAFF')) &&
                       request.resource.data.studentUid == studentField(request.resource.data.studentId, 'studentUid', '__none__') &&
                       request.resource.data.parentUid == studentField(request.resource.data.studentId, 'parentUid', '__none__') &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.status == 'PENDING';

      // ขั้นตอนชำระเงิน (src/lib/billingPayment.ts):
      //  - เจ้าหน้าที่การเงินแก้ไขได้เต็มที่ (เช่น ปรับยอด/กำหนดชำระ ตรวจสลิป) แต่ห้ามย้ายเจ้าของ
      //    และการ "เปลี่ยนเป็น" PAID ต้องลงชื่อผู้ตรวจ (verifiedBy) เป็นตัวเองเสมอ
      //  - ผู้ปกครอง/นักเรียนเจ้าของบิล ทำได้อย่างเดียว: แนบสลิป PENDING/OVERDUE → VERIFYING
      //    (แตะได้เฉพาะ field ของสลิป ห้ามตั้ง PAID/ห้ามแก้ยอด) และ URL ต้องเป็นไฟล์ใน Firebase Storage
      allow update: if (
                         (hasRole('SUPER_ADMIN') || hasRole('FINANCE_STAFF')) &&
                         request.resource.data.studentUid == resource.data.studentUid &&
                         request.resource.data.parentUid == resource.data.parentUid &&
                         (request.resource.data.status != 'PAID' ||
                           resource.data.status == 'PAID' ||
                           request.resource.data.get('verifiedBy', '') == request.auth.uid)
                       ) || (
                         isSignedIn() &&
                         (resource.data.studentUid == request.auth.uid || resource.data.parentUid == request.auth.uid) &&
                         resource.data.status in ['PENDING', 'OVERDUE'] &&
                         request.resource.data.status == 'VERIFYING' &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'status', 'slipUrl', 'slipStoragePath', 'slipFileName', 'slipUploadedAt',
                           'slipUploadedByUid', 'slipNote', 'slipRejectedReason', 'slipRejectedAt', 'updatedAt'
                         ]) &&
                         request.resource.data.slipUploadedByUid == request.auth.uid &&
                         request.resource.data.slipUrl is string &&
                         request.resource.data.slipUrl.matches('https://firebasestorage\\.googleapis\\.com/.*') &&
                         request.resource.data.get('slipRejectedReason', null) == null &&
                         request.resource.data.get('slipRejectedAt', null) == null
                       );

      allow delete: if false;
    }

    match /parent_teacher_messages/{msgId} {
      allow read: if hasRole('SUPER_ADMIN') || 
                     hasRole('HOMEROOM_TEACHER') || 
                     hasRole('SUBJECT_TEACHER') || 
                     (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.parentId == request.auth.uid || resource.data.studentId == request.auth.uid || resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid));
      allow write: if hasRole('SUPER_ADMIN') || 
                      hasRole('HOMEROOM_TEACHER') || 
                      hasRole('SUBJECT_TEACHER') || 
                      (isSignedIn() && (request.resource.data.parentUid == request.auth.uid || request.resource.data.parentId == request.auth.uid || request.resource.data.senderId == request.auth.uid || request.resource.data.studentId == request.auth.uid));
    }

    // นัดพบครูของผู้ปกครอง — สายงาน (ตรงกับ src/lib/appointmentFlow.ts):
    //   ผู้ปกครองขอนัด → REQUESTED → (ครูผู้รับ) CONFIRMED | DECLINED ; CONFIRMED → (ครูผู้รับ) COMPLETED ; REQUESTED|CONFIRMED → (ผู้ปกครอง) CANCELLED
    // ผู้รับ: HOMEROOM = ครูที่ปรึกษาของ homeroomClass นั้น, GUIDANCE = ครูแนะแนว. ข้อความส่วนตัว → อ่านได้เฉพาะเจ้าของ (parentUid/studentUid) + ผู้รับ + SUPER_ADMIN
    // query ต้องกรองด้วย parentUid / studentUid / (homeroomClass + recipient=='HOMEROOM') / (recipient=='GUIDANCE') ตามผู้ดู
    function canHandleAppointment(d) {
      return hasRole('SUPER_ADMIN')
        || (d.recipient == 'HOMEROOM' && isHomeroomTeacherOf(d.homeroomClass))
        || (d.recipient == 'GUIDANCE' && hasRole('GUIDANCE_COUNSELOR'));
    }

    match /parent_appointments/{appointmentId} {
      allow read: if canHandleAppointment(resource.data)
                  || (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.studentUid == request.auth.uid));

      // สร้าง: เฉพาะผู้ปกครองตัวจริงของนักเรียน (เทียบ students/{studentId}) เริ่มที่ REQUESTED เท่านั้น
      allow create: if request.resource.data.keys().hasOnly([
                         'id', 'studentId', 'studentUid', 'parentUid', 'homeroomClass', 'recipient', 'topic', 'preferredDate',
                         'timeSlot', 'meetingType', 'status', 'requestedBy', 'requestedAt', 'updatedAt'])
                    && request.resource.data.keys().hasAll([
                         'id', 'studentId', 'studentUid', 'parentUid', 'homeroomClass', 'recipient', 'topic', 'preferredDate',
                         'timeSlot', 'meetingType', 'status', 'requestedBy', 'requestedAt'])
                    && request.resource.data.id == appointmentId
                    && request.resource.data.parentUid is string
                    && request.auth.uid == request.resource.data.parentUid
                    && request.resource.data.parentUid == studentField(request.resource.data.studentId, 'parentUid', null)
                    && request.resource.data.studentUid == studentField(request.resource.data.studentId, 'studentUid', '__none__')
                    && request.resource.data.homeroomClass == studentField(request.resource.data.studentId, 'room', '__none__')
                    && request.resource.data.recipient in ['HOMEROOM', 'GUIDANCE']
                    && request.resource.data.topic is string && request.resource.data.topic.size() >= 1 && request.resource.data.topic.size() <= 500
                    && request.resource.data.preferredDate is string && request.resource.data.preferredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.timeSlot in ['15:30 - 16:00 น.', '16:00 - 16:30 น.', '16:30 - 17:00 น.']
                    && request.resource.data.meetingType in ['IN_PERSON', 'ONLINE_MEET']
                    && request.resource.data.status == 'REQUESTED'
                    && request.resource.data.requestedBy is string && request.resource.data.requestedBy.size() > 0;

      allow update: if (
                        // ครูผู้รับ ตอบรับ/ปฏิเสธ คำขอที่ยังรออยู่ (ยืนยันต้องระบุสถานที่/ลิงก์)
                        canHandleAppointment(resource.data)
                        && resource.data.status == 'REQUESTED'
                        && request.resource.data.status in ['CONFIRMED', 'DECLINED']
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'respondedBy', 'respondedByStaffId', 'respondedAt', 'teacherNote', 'locationOrLink', 'updatedAt'])
                        && request.resource.data.respondedBy is string && request.resource.data.respondedBy.size() > 0
                        && request.resource.data.teacherNote is string && request.resource.data.teacherNote.size() <= 500
                        && request.resource.data.locationOrLink is string && request.resource.data.locationOrLink.size() <= 300
                        && (request.resource.data.status == 'DECLINED' || request.resource.data.locationOrLink.size() >= 1)
                      ) || (
                        // ครูผู้รับ ปิดงาน "พบกันแล้ว" เฉพาะนัดที่ยืนยันแล้ว
                        canHandleAppointment(resource.data)
                        && resource.data.status == 'CONFIRMED'
                        && request.resource.data.status == 'COMPLETED'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])
                      ) || (
                        // ผู้ปกครองตัวจริงยกเลิกนัดที่ยังไม่จบ
                        isSignedIn() && request.auth.uid == resource.data.parentUid
                        && resource.data.status in ['REQUESTED', 'CONFIRMED']
                        && request.resource.data.status == 'CANCELLED'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt'])
                      );
      // ลบไม่ได้ (เป็นหลักฐานการนัด)
      allow delete: if false;
    }

    // ข้อความแจ้งผลการอนุมัติระหว่างบุคลากร (เช่น คำขอเช็คชื่อย้อนหลังของฉันได้รับอนุมัติ / การจัดครูสอนแทนถูกส่งกลับ)
    // ผู้รับระบุด้วยอีเมล (lowercase ตรงกับ token.email) — อ่านได้เฉพาะผู้รับ; บุคลากรคนใดก็ส่งได้แต่ต้องลงชื่อผู้ส่งเป็นตัวเอง
    // (นักเรียน/ผู้ปกครองส่งไม่ได้); ผู้รับแก้ได้เฉพาะ readAt (ทำเครื่องหมายอ่านแล้ว); ลบไม่ได้ (เป็นหลักฐาน)
    // ข้อความ "ผลลัพธ์" เท่านั้น — งานที่รอให้ทำอยู่ในกระดิ่งงานค้างที่คำนวณสด (src/lib/staffTasks.ts)
    match /staff_notifications/{notifId} {
      allow read: if isSignedIn() && request.auth.token.get('email', '') is string
                  && resource.data.recipientEmail == request.auth.token.get('email', '').lower();
      // หมายเหตุ: ห้ามใช้ !hasRole(...) ตรงนี้ — hasRole อ่าน token.primaryRole ซึ่งอาจไม่มี field → error เมื่อสาขา roles เป็น false (ผลคือปฏิเสธทุกคน)
      allow create: if hasAnyRole()
                    && !('STUDENT' in request.auth.token.get('roles', [])) && !('PARENT' in request.auth.token.get('roles', []))
                    && request.resource.data.keys().hasOnly(['id', 'recipientEmail', 'kind', 'title', 'message', 'refId', 'senderUid', 'senderName', 'createdAt', 'readAt'])
                    && request.resource.data.keys().hasAll(['id', 'recipientEmail', 'kind', 'title', 'message', 'refId', 'senderUid', 'senderName', 'createdAt', 'readAt'])
                    && request.resource.data.id == notifId
                    && request.resource.data.recipientEmail is string && request.resource.data.recipientEmail.matches('^[^@\\s]+@[^@\\s]+$')
                    && request.resource.data.recipientEmail == request.resource.data.recipientEmail.lower()
                    && request.resource.data.kind in ['LATE_ATTENDANCE_DECISION', 'SUBSTITUTE_UPDATE']
                    && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120
                    && request.resource.data.message is string && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 500
                    && request.resource.data.refId is string && request.resource.data.refId.size() <= 200
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.senderName is string && request.resource.data.senderName.size() >= 1
                    && request.resource.data.readAt == null;
      allow update: if isSignedIn() && request.auth.token.get('email', '') is string
                    && resource.data.recipientEmail == request.auth.token.get('email', '').lower()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
                    && request.resource.data.readAt is string;
      allow delete: if false;
    }

    // 21. Active Learning Records
    match /active_learning_logs/{logId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN') || hasRole('SUBJECT_TEACHER') || hasRole('HOMEROOM_TEACHER');
    }

    // 23. Late Attendance Requests — ครูผู้สอนขอ "เช็คชื่อย้อนหลัง" เมื่อลืมเช็คในคาบ
    // ผู้อนุมัติ: DEPUTY_DIRECTOR_ACADEMIC (รองผู้อำนวยการฝ่ายวิชาการ) / SUPER_ADMIN — ยืนยันจากทางโรงเรียน
    // document ไม่ถูกลบตอนอนุมัติ/ปฏิเสธ (allow delete: if false) — เก็บประวัติ เปลี่ยนแค่ status
    match /late_attendance_requests/{reqId} {
      // DIRECTOR อ่านได้เพื่อกำกับดูแล (read-only) — การอนุมัติจริงจบที่ DEPUTY_DIRECTOR_ACADEMIC
      allow read: if hasRole('SUPER_ADMIN') ||
                     hasRole('DEPUTY_DIRECTOR_ACADEMIC') ||
                     hasRole('DIRECTOR') ||
                     hasRole('EXECUTIVE') ||
                     (isSignedIn() && resource.data.teacherId == request.auth.uid);

      // ครูสร้างคำขอของตัวเองได้เท่านั้น และต้องเริ่มที่สถานะ PENDING
      allow create: if (hasRole('SUBJECT_TEACHER') || hasRole('HOMEROOM_TEACHER')) &&
                       request.resource.data.teacherId == request.auth.uid &&
                       request.resource.data.status == 'PENDING';

      // อนุมัติ/ปฏิเสธ (แก้ status): เฉพาะรองผอ.วิชาการ / SUPER_ADMIN
      // ห้ามแก้ teacherId / scheduleId (ตรึงไว้ให้ตรงกับของเดิม)
      allow update: if (hasRole('DEPUTY_DIRECTOR_ACADEMIC') || hasRole('SUPER_ADMIN')) &&
                       request.resource.data.teacherId == resource.data.teacherId &&
                       request.resource.data.scheduleId == resource.data.scheduleId;

      allow delete: if false;
    }

    // 22. Parent Verification Records (identity matching for LINE/LIFF account linking)
    // ข้อมูลอ่อนไหวตาม PDPA (hash เลขบัตร ปชช. + เบอร์โทร) — ใช้เทียบยืนยันฝั่ง backend เท่านั้น
    // SUPER_ADMIN เท่านั้นที่อ่าน/เขียนได้ (แม้แต่ผู้ปกครองเจ้าของข้อมูลก็ไม่ควรอ่านได้จาก client)
    match /parent_verification_records/{recordId} {
      allow read, write: if hasRole('SUPER_ADMIN');
    }

    // 24. Student Portfolio Entries — นักเรียนบันทึกผลงานเอง (รางวัล/อบรม/ฝึกงาน/จิตอาสา)
    //     ต้องผ่านการอนุมัติจากครูที่ปรึกษาก่อนแสดงให้ผู้ปกครอง/แดชบอร์ดวิชาการ
    match /student_portfolio_entries/{entryId} {
      // นักเรียนเห็นของตัวเองทุกสถานะ; ครูที่ปรึกษาห้องนั้นเห็นทั้งหมด;
      // ผู้ปกครองเห็นเฉพาะ APPROVED ของบุตรหลาน (query where('parentUid','==',uid) + where('status','==','APPROVED'))
      allow read: if hasRole('SUPER_ADMIN')
                     || (isSignedIn() && resource.data.studentUid == request.auth.uid)
                     || isHomeroomTeacherOf(resource.data.homeroomClass)
                     || (resource.data.status == 'APPROVED' && isSignedIn() && resource.data.parentUid == request.auth.uid);

      // นักเรียนสร้างได้เฉพาะของตัวเอง + status เริ่มต้น PENDING เท่านั้น + ยังไม่มีผลรีวิว
      // homeroomClass / parentUid ต้องตรงกับ students/{studentId} จริง (กัน denormalize มั่ว)
      allow create: if isSignedIn()
                       && request.resource.data.studentUid == request.auth.uid
                       && request.resource.data.status == 'PENDING'
                       && request.resource.data.reviewedBy == null
                       && request.resource.data.reviewedAt == null
                       && request.resource.data.rejectReason == null
                       && request.resource.data.homeroomClass == studentField(request.resource.data.studentId, 'room', '__none__')
                       && request.resource.data.studentUid == studentField(request.resource.data.studentId, 'studentUid', '__none__');

      // ครูที่ปรึกษา/SUPER_ADMIN แก้ได้เฉพาะฟิลด์รีวิว — ห้ามแก้เนื้อหาที่นักเรียนกรอก
      allow update: if (hasRole('SUPER_ADMIN') || isHomeroomTeacherOf(resource.data.homeroomClass))
                       && request.resource.data.studentUid == resource.data.studentUid
                       && request.resource.data.studentId == resource.data.studentId
                       && request.resource.data.homeroomClass == resource.data.homeroomClass
                       && request.resource.data.parentUid == resource.data.parentUid
                       && request.resource.data.type == resource.data.type
                       && request.resource.data.title == resource.data.title
                       && request.resource.data.description == resource.data.description
                       && request.resource.data.entryDate == resource.data.entryDate
                       && request.resource.data.status in ['APPROVED', 'REJECTED'];

      allow delete: if false;
    }

    // 25. Student Home Locations — พิกัด GPS + ภาพบ้านนักเรียน (วางแผนออกเยี่ยมบ้าน)
    //     อ่อนไหวเรื่องความปลอดภัยที่อยู่อาศัย: เจ้าของ + ครูที่ปรึกษาห้องนั้น + SUPER_ADMIN เท่านั้น
    //     **ผู้ปกครองและครูวิชาอื่นเข้าถึงไม่ได้**
    match /student_home_locations/{studentId} {
      // resource == null = doc ยังไม่ถูกสร้าง (นักเรียนเปิดหน้าก่อนบันทึกครั้งแรก) —
      // ต้องยอมให้ get ผ่านแบบ "ไม่มีข้อมูล" ไม่งั้น rule error (Null value) แล้ว listener พัง
      // TASK 4 (ExecutivePortal GIS, ยืนยันจากผู้ใช้): เพิ่ม EXECUTIVE อ่านได้ทั้งโรงเรียน (ไม่ scope ห้อง)
      // เพราะ Firestore ไม่มี field-level redaction — ฝั่ง UI ต้องรวมเป็นสรุป/จุดพิกัดเท่านั้น
      // ห้ามโชว์ชื่อ-นามสกุลนักเรียนรายคนในแผนที่ผู้บริหาร
      allow read: if hasRole('SUPER_ADMIN')
                     || hasRole('EXECUTIVE')
                     || (isSignedIn() && resource == null)
                     || (resource != null && resource.data.studentUid == request.auth.uid)
                     || (resource != null && isHomeroomTeacherOf(resource.data.homeroomClass));

      // นักเรียนเขียนของตัวเองเท่านั้น; homeroomClass ต้องตรงกับ students/{studentId} จริง
      allow create, update: if isSignedIn()
                       && request.resource.data.studentUid == request.auth.uid
                       && request.resource.data.studentId == studentId
                       && request.resource.data.homeroomClass == studentField(studentId, 'room', '__none__')
                       && request.resource.data.studentUid == studentField(studentId, 'studentUid', '__none__')
                       && request.resource.data.latitude is number
                       && request.resource.data.longitude is number
                       && request.resource.data.photoUrls.size() >= 1;

      allow delete: if false;
    }

    // 25.1 บันทึกการเยี่ยมบ้าน (แบบ สพฐ. 5 ตอน): home_visit_records/{studentId}_{ปีการศึกษา}
    //      ข้อมูลอ่อนไหวเรื่องครอบครัว/ที่อยู่อาศัย — อ่านได้เฉพาะ SUPER_ADMIN, EXECUTIVE และครูที่ปรึกษาห้องนั้น
    //      เขียนได้เฉพาะครูที่ปรึกษาห้องนั้น (หรือ SUPER_ADMIN); homeroomClass ต้องตรง students/{id}.room จริง
    //      ผู้ปกครอง/นักเรียน/ครูวิชาอื่นเข้าถึงไม่ได้; ห้ามลบ (เก็บเป็นหลักฐาน)
    match /home_visit_records/{recordId} {
      allow read: if hasRole('SUPER_ADMIN')
                     || hasRole('EXECUTIVE')
                     || (resource != null && isHomeroomTeacherOf(resource.data.homeroomClass));
      allow create: if (hasRole('SUPER_ADMIN') || isHomeroomTeacherOf(request.resource.data.homeroomClass))
                       && request.resource.data.studentId is string
                       && recordId.matches(request.resource.data.studentId + '_[0-9]{4}')
                       && request.resource.data.homeroomClass == studentField(request.resource.data.studentId, 'room', '__none__')
                       && request.resource.data.advisorUid == request.auth.uid;
      allow update: if (hasRole('SUPER_ADMIN') || isHomeroomTeacherOf(resource.data.homeroomClass))
                       && request.resource.data.studentId == resource.data.studentId
                       && request.resource.data.homeroomClass == resource.data.homeroomClass;
      allow delete: if false;
    }

    // 25.2 ข้อมูลเยี่ยมบ้านฝั่งนักเรียน (แบบ สพฐ. ข้อ 1-3, 9-11, 17-18, 20, 24): home_visit_student_info/{studentId}
    //      นักเรียนเจ้าของเขียน/อ่านของตัวเอง (studentUid ตรง students/{id}); ครูที่ปรึกษาห้องนั้น/SUPER_ADMIN/EXECUTIVE อ่านได้
    //      homeroomClass ต้องตรง students/{id}.room จริง; ผู้ปกครอง/ครูวิชาอื่นอ่านไม่ได้; ห้ามลบ
    match /home_visit_student_info/{studentId} {
      allow read: if hasRole('SUPER_ADMIN')
                     || hasRole('EXECUTIVE')
                     || (resource != null && isHomeroomTeacherOf(resource.data.homeroomClass))
                     || (isSignedIn() && resource != null && resource.data.studentUid == request.auth.uid)
                     || (isSignedIn() && resource == null && studentField(studentId, 'studentUid', '__none__') == request.auth.uid);
      allow create, update: if isSignedIn()
                       && request.resource.data.studentId == studentId
                       && request.resource.data.studentUid == request.auth.uid
                       && request.resource.data.studentUid == studentField(studentId, 'studentUid', '__none__')
                       && request.resource.data.homeroomClass == studentField(studentId, 'room', '__none__');
      allow delete: if false;
    }

    // 25.3 ข้อมูลเยี่ยมบ้านฝั่งผู้ปกครอง (ข้อ 7-8, 13, 15-16, 22-24): home_visit_family_info/{studentId}
    //      ผู้ปกครองที่ผูก parentUid กับนักเรียนเขียน/อ่านได้ (ตรง students/{id}.parentUid); ครูที่ปรึกษาห้องนั้น/SUPER_ADMIN/EXECUTIVE อ่านได้
    //      นักเรียน/ครูวิชาอื่นอ่านไม่ได้ (มีข้อมูลรายได้/ครัวเรือน); ห้ามลบ
    match /home_visit_family_info/{studentId} {
      allow read: if hasRole('SUPER_ADMIN')
                     || hasRole('EXECUTIVE')
                     || (resource != null && isHomeroomTeacherOf(resource.data.homeroomClass))
                     || (isSignedIn() && resource != null && resource.data.parentUid == request.auth.uid)
                     || (isSignedIn() && resource == null && studentField(studentId, 'parentUid', '__none__') == request.auth.uid);
      allow create, update: if isSignedIn()
                       && request.resource.data.studentId == studentId
                       && request.resource.data.parentUid == request.auth.uid
                       && request.resource.data.parentUid == studentField(studentId, 'parentUid', '__none__')
                       && request.resource.data.homeroomClass == studentField(studentId, 'room', '__none__');
      allow delete: if false;
    }

    // 25.4 ข้อมูลอ้างอิงที่แอดมินแก้ไขได้: รายชื่อโรงเรียน (reference_schools) / หมู่บ้าน (reference_villages)
    //      เก็บเฉพาะส่วนที่ต่างจากข้อมูลชุดหลักในแอป (เพิ่มใหม่/แก้/ซ่อน) — ไม่ใช่ข้อมูลอ่อนไหว: ผู้ที่ล็อกอินอ่านได้ (ฟอร์มนักเรียนใช้เลือก)
    //      เขียน/ลบ: SUPER_ADMIN เท่านั้น (ห้าม bare isSignedIn() ที่ write)
    match /reference_schools/{refId} {
      allow read: if isSignedIn();
      allow create, update: if hasRole('SUPER_ADMIN')
                       && request.resource.data.provinceCode is string && request.resource.data.provinceCode.size() == 2
                       && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200;
      allow delete: if hasRole('SUPER_ADMIN');
    }
    match /reference_villages/{refId} {
      allow read: if isSignedIn();
      allow create, update: if hasRole('SUPER_ADMIN')
                       && request.resource.data.tambonCode is string && request.resource.data.tambonCode.size() == 6
                       && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200;
      allow delete: if hasRole('SUPER_ADMIN');
    }

    // 26. Department config — กลุ่มสาระฯ/กลุ่มงาน (แอดมินจัดการ)
    match /department_config/{deptId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN');
    }

    // 27. Elective activity config — ชุมนุม/กิจกรรมตามความสนใจ (ELECTIVE, สมัครเอง มีที่นั่งจำกัด)
    // ที่แอดมินงานชุมนุมสร้างชื่อ+จำนวนรับ+ครูรับผิดชอบเองตรงๆ (ออกแบบใหม่ — ไม่ผูกกับ subjectCode
    // ที่ import จากตารางสอนอีกต่อไป)
    match /elective_activities_config/{configId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN') || hasRole('ACADEMIC_HEAD');
    }

    // 28. Activity enrollments — การสมัคร/ถอนชุมนุมของนักเรียน (ไม่ลบ doc จริง mark removedAt แทน)
    // read กว้าง (isSignedIn) เพราะนักเรียนต้องเห็นจำนวนที่สมัครแล้วของ "คนอื่น" ด้วยเพื่อคำนวณที่นั่ง
    // เหลือ — ไม่ใช่ข้อมูลอ่อนไหวระดับเดียวกับสุขภาพจิต/การเงิน (แค่ว่าใครสมัครชุมนุมอะไร)
    match /activity_enrollments/{enrollmentId} {
      allow read: if isSignedIn();

      // สมัคร: สร้าง doc ของตัวเองเท่านั้น ต้องยังไม่ถอน (removedAt/removedBy ต้องเป็น null ตอนสร้าง)
      // และชุมนุมนั้นต้องยังเปิดรับสมัครอยู่ (enrollmentStatus == 'OPEN') — ปิดรับสมัครแล้วห้ามสมัครใหม่
      // ผ่าน Firestore ตรงๆ แม้จะข้าม UI มา (ปุ่ม "สมัคร" ฝั่ง UI ก็ disable ไว้แล้วเช่นกัน) — เช็ค
      // exists() ก่อนเสมอ กัน get() พังตอน activityId ไม่มี config จริง (ให้ผ่านเหมือนเดิม ไม่ใช่ error)
      allow create: if hasRole('STUDENT')
                       && request.resource.data.studentUid == request.auth.uid
                       && request.resource.data.removedAt == null
                       && request.resource.data.removedBy == null
                       && studentField(request.resource.data.studentId, 'studentUid', '__none__') == request.auth.uid
                       && (
                         !exists(/databases/$(database)/documents/elective_activities_config/$(request.resource.data.activityId)) ||
                         get(/databases/$(database)/documents/elective_activities_config/$(request.resource.data.activityId)).data.get('enrollmentStatus', 'OPEN') == 'OPEN'
                       );

      // ถอน: แก้ได้เฉพาะ removedAt/removedBy/removedReason เท่านั้น — นักเรียนถอนตัวเอง
      // (removedBy ต้องเป็น null) หรือครูรับผิดชอบชุมนุมนั้นถอน (removedBy ต้องเป็น uid ตัวเอง)
      allow update: if (
                         // นักเรียนสมัครใหม่หลังถอน: doc ต้องเคยถอนแล้ว, กลับเป็น active (removedAt/By/Reason = null),
                         // แตะได้เฉพาะ enrolledAt + ฟิลด์สถานะ, และชุมนุมต้องยังเปิดรับสมัคร
                         hasRole('STUDENT')
                         && resource.data.studentUid == request.auth.uid
                         && resource.data.removedAt != null
                         && request.resource.data.removedAt == null
                         && request.resource.data.removedBy == null
                         && request.resource.data.get('removedReason', null) == null
                         && request.resource.data.studentUid == request.auth.uid
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledAt', 'removedAt', 'removedBy', 'removedReason'])
                         && (
                           !exists(/databases/$(database)/documents/elective_activities_config/$(resource.data.activityId)) ||
                           get(/databases/$(database)/documents/elective_activities_config/$(resource.data.activityId)).data.get('enrollmentStatus', 'OPEN') == 'OPEN'
                         )
                       ) || (
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removedAt', 'removedBy', 'removedReason'])
                       && (
                         (hasRole('STUDENT') && resource.data.studentUid == request.auth.uid && request.resource.data.removedBy == null) ||
                         (
                           (hasRole('SUBJECT_TEACHER') || hasRole('HOMEROOM_TEACHER')) &&
                           request.resource.data.removedBy == request.auth.uid &&
                           isResponsibleTeacherOfActivity(resource.data.activityId)
                         ) ||
                         hasRole('SUPER_ADMIN')
                       ));

      allow delete: if false;
    }

    // 28.1 Activity enrollment counts — ตัวนับที่นั่งต่อ activityId (derived, sync คู่กับ
    // activity_enrollments เสมอในทรานแซกชันเดียวกัน — ดู enrollInActivity/withdrawFromActivity)
    // จำเป็นเพราะ Firestore transaction อ่านได้แค่ document เดียว query ไม่ได้ ใช้ตัวนับนี้แทน
    // การนับจริงจาก activity_enrollments เพื่อตรวจที่นั่งแบบ atomic กัน race condition
    match /activity_enrollment_counts/{activityId} {
      allow read: if isSignedIn();
      allow write: if (hasRole('STUDENT') || hasRole('SUBJECT_TEACHER') || hasRole('HOMEROOM_TEACHER') || hasRole('SUPER_ADMIN'))
                      && request.resource.data.count is int
                      && request.resource.data.count >= 0;
    }

    // 29. House config (คณะสี) — รากฐานสำหรับระบบคะแนนถ้วยในอนาคต ยังไม่มีการคำนวณคะแนนตอนนี้
    match /house_config/{houseId} {
      allow read: if isSignedIn();
      allow write: if hasRole('SUPER_ADMIN') || hasRole('ACADEMIC_HEAD');
    }

    // 30. Guidance Counseling Cases — เนื้อหาการให้คำปรึกษาจิตวิทยาของผู้เยาว์ ข้อมูลอ่อนไหวที่สุด
    // ในระบบ ตั้งใจให้เข้มงวดกว่า collection สุขภาพจิตอื่นๆ ทุกตัว: GUIDANCE_COUNSELOR/SUPER_ADMIN
    // เท่านั้น — ครูประจำชั้น ครูวิชาอื่น ผู้ปกครอง และตัวนักเรียนเจ้าของเคส "ห้ามอ่านได้" ทั้งหมด
    // (ต่างจาก student_screenings_2q/phq9/student_assessments_sdq ที่ยังให้ HOMEROOM_TEACHER/
    // self อ่านได้ — เคสนี้คือบันทึกการให้คำปรึกษาจริง ไม่ใช่แค่ผลคัดกรอง)
    match /guidance_counseling_cases/{caseId} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR');
      // counselorUid ต้องตรงกับผู้เขียนจริงเสมอตอนสร้าง กันปลอมชื่อผู้บันทึก
      allow create: if (hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR')) &&
                       request.resource.data.counselorUid == request.auth.uid;
      allow update, delete: if hasRole('SUPER_ADMIN') || hasRole('GUIDANCE_COUNSELOR');
    }

    // 31. Infirmary Visits — ห้องพยาบาล บันทึกอาการ/การรักษา ตั้งใจให้ "เห็นได้" โดยผู้ปกครองและ
    // นักเรียนเจ้าของ (ต่างจาก guidance_counseling_cases ด้านบนที่ปิดไม่ให้อ่านเลย) —
    // studentUid/parentUid ต้องตรงกับ students/{studentId} จริงเสมอ กันพยาบาลพิมพ์ผิดแล้วส่ง
    // ข้อมูลไปให้ผู้ปกครองคนละครอบครัวเห็น (ดู studentField())
    match /infirmary_visits/{visitId} {
      allow read: if hasRole('SUPER_ADMIN') ||
                     hasRole('INFIRMARY_STAFF') ||
                     hasRole('EXECUTIVE') ||
                     (isSignedIn() && (resource.data.studentUid == request.auth.uid || resource.data.parentUid == request.auth.uid));

      allow create: if (hasRole('SUPER_ADMIN') || hasRole('INFIRMARY_STAFF')) &&
                       request.resource.data.studentUid == studentField(request.resource.data.studentId, 'studentUid', '__none__') &&
                       request.resource.data.parentUid == studentField(request.resource.data.studentId, 'parentUid', '__none__');

      // พยาบาล/แอดมินแก้เนื้อหาได้แต่ห้ามย้ายเจ้าของ (studentUid/parentUid ต้องคงเดิม) —
      // ผู้ปกครองเจ้าของ (parentUid ตรง) แก้ได้เฉพาะ "กดรับทราบ" (parentAcknowledged/acknowledgedAt) เท่านั้น
      allow update: if (
                        (hasRole('SUPER_ADMIN') || hasRole('INFIRMARY_STAFF')) &&
                        request.resource.data.studentUid == resource.data.studentUid &&
                        request.resource.data.parentUid == resource.data.parentUid
                      ) || (
                        isSignedIn() && resource.data.parentUid == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentAcknowledged', 'acknowledgedAt'])
                      );

      allow delete: if false;
    }

    // 32. Semester Health Log — น้ำหนัก/ส่วนสูงรายภาคเรียน
    // ยืนยันจากโรงเรียน: นักเรียนกรอกเอง "ภาคเรียนละ 1 ครั้ง" (ลดภาระงานพยาบาลที่ดูแลทั้งโรงเรียน)
    // doc id = {studentId}_{academicYear}_{term} → กรอกซ้ำภาคเรียนเดิมชนกับ doc เดิม create ไม่ผ่าน
    // (exists) = บังคับ 1 ครั้ง/ภาคเรียนที่ layer นี้ด้วย. พยาบาล (INFIRMARY_STAFF) บันทึกแทน/แก้ไข
    // ได้กรณีพิเศษ (นักเรียนลืมกรอก/กรอกผิด). ครูที่ปรึกษา/แนะแนว/ผู้ปกครอง อ่านได้
    match /student_semester_health/{docId} {
      allow read: if hasRole('SUPER_ADMIN') ||
                     hasRole('INFIRMARY_STAFF') ||
                     hasRole('HOMEROOM_TEACHER') ||
                     hasRole('GUIDANCE_COUNSELOR') ||
                     (isSignedIn() && (resource.data.studentUid == request.auth.uid || resource.data.parentUid == request.auth.uid));

      // studentUid/parentUid ต้อง denormalize ตรงกับ students/{studentId} จริงเสมอ (กันส่งข้อมูล
      // ไปให้ครอบครัวอื่นเห็น) + docId ต้องเป็น {studentId}_{academicYear}_{term} เป๊ะ
      // (กันนักเรียนตั้ง id มั่วเพื่อกรอกหลายครั้งต่อภาคเรียน)
      allow create: if request.resource.data.studentUid == studentField(request.resource.data.studentId, 'studentUid', '__none__') &&
                       request.resource.data.parentUid == studentField(request.resource.data.studentId, 'parentUid', null) &&
                       docId == request.resource.data.studentId + '_' + request.resource.data.academicYear + '_' + request.resource.data.term &&
                       (
                         hasRole('SUPER_ADMIN') ||
                         hasRole('INFIRMARY_STAFF') ||
                         (
                           isSelfStudent(request.resource.data.studentId) &&
                           request.resource.data.recordedByUid == request.auth.uid
                         )
                       );

      // แก้ไข/บันทึกแทน: พยาบาล/แอดมิน เท่านั้น (นักเรียนแก้ย้อนหลังเองไม่ได้) — ห้ามย้ายเจ้าของ
      allow update: if (hasRole('SUPER_ADMIN') || hasRole('INFIRMARY_STAFF')) &&
                       request.resource.data.studentId == resource.data.studentId &&
                       request.resource.data.studentUid == resource.data.studentUid;

      allow delete: if hasRole('SUPER_ADMIN');
    }

    // Default Deny All Catch-All for unknown paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
