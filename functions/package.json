{
  "name": "functions",
  "description": "Cloud Functions for Smart School Care Ecosystem",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions:assignUserRole,functions:createStaffMember,functions:setStaffActive,functions:refreshGuidanceStatus,functions:beforeCreate,functions:beforeSignIn",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "private": true
}
